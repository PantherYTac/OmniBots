<% 
  const currentTab = typeof tab !== 'undefined' ? tab : 'overview';
  const gid = typeof guild !== 'undefined' && guild ? guild.id : '';
%>
<aside class="w-64 bg-[#0D1117] border-r border-white/5 flex flex-col flex-shrink-0 min-h-[calc(100vh-64px)]">

  <!-- Server Identity Header -->
  <% if (typeof guild !== 'undefined' && guild) { %>
    <div class="p-4 border-b border-white/5 flex items-center gap-3">
      <% const iconUrl = guild.icon ? `https://cdn.discordapp.com/icons/${guild.id}/${guild.icon}.png?size=64` : null; %>
      <% if (iconUrl) { %>
        <img src="<%= iconUrl %>" alt="<%= guild.name %>" class="w-9 h-9 rounded-xl ring-1 ring-white/10 flex-shrink-0">
      <% } else { %>
        <div class="w-9 h-9 rounded-xl bg-gradient-to-br from-blurple to-blurple/60 text-white font-bold flex items-center justify-center text-xs flex-shrink-0">
          <%= guild.name.substring(0, 2).toUpperCase() %>
        </div>
      <% } %>
      <div class="overflow-hidden">
        <h2 class="font-semibold text-sm text-white truncate leading-tight"><%= guild.name %></h2>
        <a href="/dashboard" class="text-[11px] text-blurple hover:text-blurple/80 flex items-center gap-1 mt-0.5 transition-colors duration-150">
          <i data-lucide="arrow-left" class="w-3 h-3"></i> Switch Server
        </a>
      </div>
    </div>
  <% } %>

  <!-- Navigation Menu Links -->
  <div class="p-2 flex-1 space-y-0.5 overflow-y-auto">

    <!-- Dashboard Section -->
    <div class="text-[10px] font-semibold uppercase tracking-widest text-slate-600 px-2 py-2 mt-2">Dashboard</div>

    <a href="/dashboard/bots" class="flex items-center gap-2.5 px-3 py-2 rounded-lg text-[13px] font-medium transition-all duration-150 <%= currentTab === 'bots' ? 'bg-blurple/10 text-white border-l-2 border-blurple pl-[10px]' : 'text-slate-400 hover:text-white hover:bg-white/5' %>">
      <i data-lucide="cpu" class="w-4 h-4 flex-shrink-0 <%= currentTab === 'bots' ? '' : 'opacity-75' %>"></i>
      <span>Multi-Bot Fleet Hub</span>
    </a>

    <a href="/dashboard/<%= gid %>" class="flex items-center gap-2.5 px-3 py-2 rounded-lg text-[13px] font-medium transition-all duration-150 <%= currentTab === 'overview' ? 'bg-blurple/10 text-white border-l-2 border-blurple pl-[10px]' : 'text-slate-400 hover:text-white hover:bg-white/5' %>">
      <i data-lucide="layout-dashboard" class="w-4 h-4 flex-shrink-0 <%= currentTab === 'overview' ? '' : 'opacity-75' %>"></i>
      <span>Overview & Stats</span>
    </a>

    <a href="/dashboard/<%= gid %>/commands" class="flex items-center gap-2.5 px-3 py-2 rounded-lg text-[13px] font-medium transition-all duration-150 <%= currentTab === 'commands' ? 'bg-blurple/10 text-white border-l-2 border-blurple pl-[10px]' : 'text-slate-400 hover:text-white hover:bg-white/5' %>">
      <i data-lucide="command" class="w-4 h-4 flex-shrink-0 <%= currentTab === 'commands' ? '' : 'opacity-75' %>"></i>
      <span>Commands & Permissions</span>
    </a>

    <a href="/dashboard/<%= gid %>/general" class="flex items-center gap-2.5 px-3 py-2 rounded-lg text-[13px] font-medium transition-all duration-150 <%= currentTab === 'general' ? 'bg-blurple/10 text-white border-l-2 border-blurple pl-[10px]' : 'text-slate-400 hover:text-white hover:bg-white/5' %>">
      <i data-lucide="sliders" class="w-4 h-4 flex-shrink-0 <%= currentTab === 'general' ? '' : 'opacity-75' %>"></i>
      <span>General & Modules</span>
    </a>

    <a href="/dashboard/presence" class="flex items-center gap-2.5 px-3 py-2 rounded-lg text-[13px] font-medium transition-all duration-150 <%= currentTab === 'presence' ? 'bg-blurple/10 text-white border-l-2 border-blurple pl-[10px]' : 'text-slate-400 hover:text-white hover:bg-white/5' %>">
      <i data-lucide="activity" class="w-4 h-4 flex-shrink-0 <%= currentTab === 'presence' ? '' : 'opacity-75' %>"></i>
      <span>Bot Status & Presence</span>
    </a>

    <a href="/dashboard/legal" class="flex items-center gap-2.5 px-3 py-2 rounded-lg text-[13px] font-medium transition-all duration-150 <%= currentTab === 'legal' ? 'bg-blurple/10 text-white border-l-2 border-blurple pl-[10px]' : 'text-slate-400 hover:text-white hover:bg-white/5' %>">
      <i data-lucide="scale" class="w-4 h-4 flex-shrink-0 <%= currentTab === 'legal' ? '' : 'opacity-75' %>"></i>
      <span>Legal & Verification</span>
    </a>

    <!-- Management Section -->
    <div class="text-[10px] font-semibold uppercase tracking-widest text-slate-600 px-2 py-2 mt-2">Management</div>

    <a href="/dashboard/<%= gid %>/automod" class="flex items-center gap-2.5 px-3 py-2 rounded-lg text-[13px] font-medium transition-all duration-150 <%= currentTab === 'automod' ? 'bg-blurple/10 text-white border-l-2 border-blurple pl-[10px]' : 'text-slate-400 hover:text-white hover:bg-white/5' %>">
      <i data-lucide="shield-alert" class="w-4 h-4 flex-shrink-0 <%= currentTab === 'automod' ? '' : 'opacity-75' %>"></i>
      <span>Auto-Mod & Rules</span>
    </a>

    <a href="/dashboard/<%= gid %>/reaction-roles" class="flex items-center gap-2.5 px-3 py-2 rounded-lg text-[13px] font-medium transition-all duration-150 <%= currentTab === 'reaction-roles' ? 'bg-blurple/10 text-white border-l-2 border-blurple pl-[10px]' : 'text-slate-400 hover:text-white hover:bg-white/5' %>">
      <i data-lucide="mouse-pointer-click" class="w-4 h-4 flex-shrink-0 <%= currentTab === 'reaction-roles' ? '' : 'opacity-75' %>"></i>
      <span>Reaction & Button Roles</span>
    </a>

    <a href="/dashboard/<%= gid %>/invites" class="flex items-center gap-2.5 px-3 py-2 rounded-lg text-[13px] font-medium transition-all duration-150 <%= currentTab === 'invites' ? 'bg-blurple/10 text-white border-l-2 border-blurple pl-[10px]' : 'text-slate-400 hover:text-white hover:bg-white/5' %>">
      <i data-lucide="user-plus" class="w-4 h-4 flex-shrink-0 <%= currentTab === 'invites' ? '' : 'opacity-75' %>"></i>
      <span>Invite Tracker</span>
    </a>

    <a href="/dashboard/<%= gid %>/embeds" class="flex items-center gap-2.5 px-3 py-2 rounded-lg text-[13px] font-medium transition-all duration-150 <%= currentTab === 'embeds' ? 'bg-blurple/10 text-white border-l-2 border-blurple pl-[10px]' : 'text-slate-400 hover:text-white hover:bg-white/5' %>">
      <i data-lucide="megaphone" class="w-4 h-4 flex-shrink-0 <%= currentTab === 'embeds' ? '' : 'opacity-75' %>"></i>
      <span>Embed Builder</span>
    </a>

    <a href="/dashboard/<%= gid %>/welcomer" class="flex items-center gap-2.5 px-3 py-2 rounded-lg text-[13px] font-medium transition-all duration-150 <%= currentTab === 'welcomer' ? 'bg-blurple/10 text-white border-l-2 border-blurple pl-[10px]' : 'text-slate-400 hover:text-white hover:bg-white/5' %>">
      <i data-lucide="sparkles" class="w-4 h-4 flex-shrink-0 <%= currentTab === 'welcomer' ? '' : 'opacity-75' %>"></i>
      <span>Welcomer & Farewell</span>
    </a>

    <a href="/dashboard/<%= gid %>/custom-commands" class="flex items-center gap-2.5 px-3 py-2 rounded-lg text-[13px] font-medium transition-all duration-150 <%= currentTab === 'custom-commands' ? 'bg-blurple/10 text-white border-l-2 border-blurple pl-[10px]' : 'text-slate-400 hover:text-white hover:bg-white/5' %>">
      <i data-lucide="terminal" class="w-4 h-4 flex-shrink-0 <%= currentTab === 'custom-commands' ? '' : 'opacity-75' %>"></i>
      <span>Custom Commands</span>
    </a>

    <a href="/dashboard/<%= gid %>/leveling" class="flex items-center gap-2.5 px-3 py-2 rounded-lg text-[13px] font-medium transition-all duration-150 <%= currentTab === 'leveling' ? 'bg-blurple/10 text-white border-l-2 border-blurple pl-[10px]' : 'text-slate-400 hover:text-white hover:bg-white/5' %>">
      <i data-lucide="award" class="w-4 h-4 flex-shrink-0 <%= currentTab === 'leveling' ? '' : 'opacity-75' %>"></i>
      <span>Leveling & Shop</span>
    </a>

    <a href="/dashboard/<%= gid %>/tickets" class="flex items-center gap-2.5 px-3 py-2 rounded-lg text-[13px] font-medium transition-all duration-150 <%= currentTab === 'tickets' ? 'bg-blurple/10 text-white border-l-2 border-blurple pl-[10px]' : 'text-slate-400 hover:text-white hover:bg-white/5' %>">
      <i data-lucide="ticket" class="w-4 h-4 flex-shrink-0 <%= currentTab === 'tickets' ? '' : 'opacity-75' %>"></i>
      <span>Support Tickets</span>
    </a>

    <a href="/dashboard/<%= gid %>/applications" class="flex items-center gap-2.5 px-3 py-2 rounded-lg text-[13px] font-medium transition-all duration-150 <%= currentTab === 'applications' ? 'bg-blurple/10 text-white border-l-2 border-blurple pl-[10px]' : 'text-slate-400 hover:text-white hover:bg-white/5' %>">
      <i data-lucide="clipboard-check" class="w-4 h-4 flex-shrink-0 <%= currentTab === 'applications' ? '' : 'opacity-75' %>"></i>
      <span>Staff Applications</span>
    </a>

    <!-- Public Section -->
    <div class="text-[10px] font-semibold uppercase tracking-widest text-slate-600 px-2 py-2 mt-2">Public</div>

    <a href="/leaderboard/<%= gid %>" target="_blank" class="flex items-center justify-between px-3 py-2 rounded-lg text-[13px] font-medium text-slate-400 hover:text-white hover:bg-white/5 transition-all duration-150">
      <div class="flex items-center gap-2.5">
        <i data-lucide="trophy" class="w-4 h-4 flex-shrink-0 opacity-75"></i>
        <span>Public Leaderboard</span>
      </div>
      <i data-lucide="external-link" class="w-3 h-3 text-slate-600 flex-shrink-0"></i>
    </a>

  </div>

  <!-- Sidebar Footer -->
  <div class="p-2 border-t border-white/5">
    <form action="/logout" method="POST" class="w-full">
      <button type="submit" class="w-full flex items-center gap-2.5 px-3 py-2 rounded-lg text-[13px] font-medium text-slate-500 hover:text-red-400 hover:bg-red-500/5 transition-all duration-150">
        <i data-lucide="log-out" class="w-4 h-4 flex-shrink-0 opacity-75"></i>
        <span>Logout Admin</span>
      </button>
    </form>
  </div>

</aside>
