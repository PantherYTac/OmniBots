<% 
  const currentTab = typeof tab !== 'undefined' ? tab : 'overview';
  const gid = typeof guild !== 'undefined' && guild ? guild.id : '';
%>
<aside class="w-64 bg-[#131823] border-r border-[#1E2538] flex flex-col flex-shrink-0 min-h-[calc(100vh-65px)]">
  <!-- Server Identity Header -->
  <% if (typeof guild !== 'undefined' && guild) { %>
    <div class="p-4 border-b border-[#1E2538] flex items-center gap-3">
      <% const iconUrl = guild.icon ? `https://cdn.discordapp.com/icons/${guild.id}/${guild.icon}.png?size=64` : null; %>
      <% if (iconUrl) { %>
        <img src="<%= iconUrl %>" alt="<%= guild.name %>" class="w-10 h-10 rounded-xl ring-1 ring-[#1E2538]">
      <% } else { %>
        <div class="w-10 h-10 rounded-xl bg-blurple/20 border border-blurple/40 text-blurple font-bold flex items-center justify-center text-sm">
          <%= guild.name.substring(0, 2).toUpperCase() %>
        </div>
      <% } %>
      <div class="overflow-hidden">
        <h2 class="text-sm font-bold text-white truncate"><%= guild.name %></h2>
        <a href="/dashboard" class="text-xs text-blurple hover:underline flex items-center gap-1">
          <i data-lucide="arrow-left" class="w-3 h-3"></i> Switch Server
        </a>
      </div>
    </div>
  <% } %>

  <!-- Navigation Menu Links -->
  <div class="p-3 flex-1 space-y-1 overflow-y-auto">
    <div class="px-3 py-1.5 text-xs font-semibold text-slate-500 uppercase tracking-wider">Dashboard</div>

    <a href="/dashboard/bots" class="flex items-center gap-3 px-3 py-2 rounded-lg text-sm font-medium transition <%= currentTab === 'bots' ? 'bg-blurple text-white font-semibold shadow-md shadow-blurple/20' : 'text-slate-300 hover:bg-[#1E2538] hover:text-white' %>">
      <i data-lucide="cpu" class="w-4 h-4 text-cyan-accent"></i>
      <span>Multi-Bot Fleet Hub</span>
    </a>

    <a href="/dashboard/<%= gid %>" class="flex items-center gap-3 px-3 py-2 rounded-lg text-sm font-medium transition <%= currentTab === 'overview' ? 'bg-blurple text-white font-semibold shadow-md shadow-blurple/20' : 'text-slate-300 hover:bg-[#1E2538] hover:text-white' %>">
      <i data-lucide="layout-dashboard" class="w-4 h-4"></i>
      <span>Overview & Stats</span>
    </a>

    <a href="/dashboard/<%= gid %>/commands" class="flex items-center gap-3 px-3 py-2 rounded-lg text-sm font-medium transition <%= currentTab === 'commands' ? 'bg-blurple text-white font-semibold shadow-md shadow-blurple/20' : 'text-slate-300 hover:bg-[#1E2538] hover:text-white' %>">
      <i data-lucide="command" class="w-4 h-4 text-blurple"></i>
      <span>Commands & Permissions</span>
    </a>

    <a href="/dashboard/<%= gid %>/general" class="flex items-center gap-3 px-3 py-2 rounded-lg text-sm font-medium transition <%= currentTab === 'general' ? 'bg-blurple text-white font-semibold shadow-md shadow-blurple/20' : 'text-slate-300 hover:bg-[#1E2538] hover:text-white' %>">
      <i data-lucide="sliders" class="w-4 h-4"></i>
      <span>General & Modules</span>
    </a>

    <a href="/dashboard/presence" class="flex items-center gap-3 px-3 py-2 rounded-lg text-sm font-medium transition <%= currentTab === 'presence' ? 'bg-blurple text-white font-semibold shadow-md shadow-blurple/20' : 'text-slate-300 hover:bg-[#1E2538] hover:text-white' %>">
      <i data-lucide="activity" class="w-4 h-4"></i>
      <span>Bot Status & Presence</span>
    </a>

    <a href="/dashboard/legal" class="flex items-center gap-3 px-3 py-2 rounded-lg text-sm font-medium transition <%= currentTab === 'legal' ? 'bg-blurple text-white font-semibold shadow-md shadow-blurple/20' : 'text-slate-300 hover:bg-[#1E2538] hover:text-white' %>">
      <i data-lucide="scale" class="w-4 h-4"></i>
      <span>Legal & Verification</span>
    </a>

    <div class="pt-4 px-3 py-1.5 text-xs font-semibold text-slate-500 uppercase tracking-wider">Management</div>

    <a href="/dashboard/<%= gid %>/automod" class="flex items-center gap-3 px-3 py-2 rounded-lg text-sm font-medium transition <%= currentTab === 'automod' ? 'bg-blurple text-white font-semibold shadow-md shadow-blurple/20' : 'text-slate-300 hover:bg-[#1E2538] hover:text-white' %>">
      <i data-lucide="shield-alert" class="w-4 h-4"></i>
      <span>Auto-Mod & Rules</span>
    </a>

    <a href="/dashboard/<%= gid %>/reaction-roles" class="flex items-center gap-3 px-3 py-2 rounded-lg text-sm font-medium transition <%= currentTab === 'reaction-roles' ? 'bg-blurple text-white font-semibold shadow-md shadow-blurple/20' : 'text-slate-300 hover:bg-[#1E2538] hover:text-white' %>">
      <i data-lucide="mouse-pointer-click" class="w-4 h-4"></i>
      <span>Reaction & Button Roles</span>
    </a>

    <a href="/dashboard/<%= gid %>/invites" class="flex items-center gap-3 px-3 py-2 rounded-lg text-sm font-medium transition <%= currentTab === 'invites' ? 'bg-blurple text-white font-semibold shadow-md shadow-blurple/20' : 'text-slate-300 hover:bg-[#1E2538] hover:text-white' %>">
      <i data-lucide="user-plus" class="w-4 h-4"></i>
      <span>Invite Tracker</span>
    </a>

    <a href="/dashboard/<%= gid %>/embeds" class="flex items-center gap-3 px-3 py-2 rounded-lg text-sm font-medium transition <%= currentTab === 'embeds' ? 'bg-blurple text-white font-semibold shadow-md shadow-blurple/20' : 'text-slate-300 hover:bg-[#1E2538] hover:text-white' %>">
      <i data-lucide="megaphone" class="w-4 h-4"></i>
      <span>Embed Builder</span>
    </a>

    <a href="/dashboard/<%= gid %>/welcomer" class="flex items-center gap-3 px-3 py-2 rounded-lg text-sm font-medium transition <%= currentTab === 'welcomer' ? 'bg-blurple text-white font-semibold shadow-md shadow-blurple/20' : 'text-slate-300 hover:bg-[#1E2538] hover:text-white' %>">
      <i data-lucide="sparkles" class="w-4 h-4"></i>
      <span>Welcomer & Farewell</span>
    </a>

    <a href="/dashboard/<%= gid %>/custom-commands" class="flex items-center gap-3 px-3 py-2 rounded-lg text-sm font-medium transition <%= currentTab === 'custom-commands' ? 'bg-blurple text-white font-semibold shadow-md shadow-blurple/20' : 'text-slate-300 hover:bg-[#1E2538] hover:text-white' %>">
      <i data-lucide="terminal" class="w-4 h-4"></i>
      <span>Custom Commands</span>
    </a>

    <a href="/dashboard/<%= gid %>/leveling" class="flex items-center gap-3 px-3 py-2 rounded-lg text-sm font-medium transition <%= currentTab === 'leveling' ? 'bg-blurple text-white font-semibold shadow-md shadow-blurple/20' : 'text-slate-300 hover:bg-[#1E2538] hover:text-white' %>">
      <i data-lucide="award" class="w-4 h-4"></i>
      <span>Leveling & Shop</span>
    </a>

    <a href="/dashboard/<%= gid %>/tickets" class="flex items-center gap-3 px-3 py-2 rounded-lg text-sm font-medium transition <%= currentTab === 'tickets' ? 'bg-blurple text-white font-semibold shadow-md shadow-blurple/20' : 'text-slate-300 hover:bg-[#1E2538] hover:text-white' %>">
      <i data-lucide="ticket" class="w-4 h-4"></i>
      <span>Support Tickets</span>
    </a>

    <a href="/dashboard/<%= gid %>/applications" class="flex items-center gap-3 px-3 py-2 rounded-lg text-sm font-medium transition <%= currentTab === 'applications' ? 'bg-blurple text-white font-semibold shadow-md shadow-blurple/20' : 'text-slate-300 hover:bg-[#1E2538] hover:text-white' %>">
      <i data-lucide="clipboard-check" class="w-4 h-4 text-emerald-400"></i>
      <span>Staff Applications</span>
    </a>

    <div class="pt-4 px-3 py-1.5 text-xs font-semibold text-slate-500 uppercase tracking-wider">Public</div>

    <a href="/leaderboard/<%= gid %>" target="_blank" class="flex items-center justify-between px-3 py-2 rounded-lg text-sm font-medium text-slate-300 hover:bg-[#1E2538] hover:text-white transition">
      <div class="flex items-center gap-3">
        <i data-lucide="trophy" class="w-4 h-4 text-yellow-400"></i>
        <span>Public Leaderboard</span>
      </div>
      <i data-lucide="external-link" class="w-3.5 h-3.5 text-slate-500"></i>
    </a>
  </div>

  <!-- Sidebar Footer with Master Admin Logout -->
  <div class="p-3 border-t border-[#1E2538]">
    <form action="/logout" method="POST" class="w-full">
      <button type="submit" class="w-full flex items-center gap-3 px-3 py-2 rounded-lg text-sm font-medium text-red-400 hover:bg-red-500/10 hover:text-red-300 transition">
        <i data-lucide="log-out" class="w-4 h-4"></i>
        <span>Logout Admin</span>
      </button>
    </form>
  </div>
</aside>
