<!-- Modal: Database Backup & Restore / Migration Utility -->
<div id="backup-modal" class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/75 backdrop-blur-md hidden transition-opacity duration-200">
  <div class="relative w-full max-w-lg bg-[#0D1117] border border-white/10 rounded-2xl shadow-2xl p-6 sm:p-7 space-y-5 animate-in fade-in zoom-in-95 duration-150">

    <!-- Modal Header -->
    <div class="flex items-start justify-between border-b border-white/5 pb-4">
      <div class="flex items-center gap-3">
        <div class="w-10 h-10 rounded-xl bg-emerald-500/15 border border-emerald-500/30 text-emerald-400 flex items-center justify-center flex-shrink-0">
          <i data-lucide="database" class="w-5 h-5"></i>
        </div>
        <div>
          <h3 class="text-base font-bold text-white">Database Backup &amp; Migration</h3>
          <p class="text-xs text-slate-400 mt-0.5">Safely export and restore all bots, tokens, tickets, and configurations across updates.</p>
        </div>
      </div>
      <button type="button" onclick="closeBackupModal()" class="text-slate-500 hover:text-white p-1 rounded-lg hover:bg-white/5 transition">
        <i data-lucide="x" class="w-5 h-5"></i>
      </button>
    </div>

    <!-- Section 1: Export Database -->
    <div class="p-4 rounded-xl bg-[#0B0E14] border border-white/6 space-y-2.5">
      <div class="flex items-center justify-between">
        <div class="text-xs font-semibold text-white flex items-center gap-2">
          <i data-lucide="download" class="w-4 h-4 text-emerald-400"></i>
          <span>Export Database Backup</span>
        </div>
        <span class="text-[10px] text-slate-500 font-mono">.json format</span>
      </div>
      <p class="text-[11px] text-slate-400 leading-relaxed">
        Download a complete JSON snapshot containing all added bots, encrypted tokens, tickets, applications, and server modules.
      </p>
      <a 
        href="/api/database/export" 
        download 
        class="inline-flex items-center gap-2 px-4 py-2 rounded-xl text-xs font-bold text-white bg-emerald-600 hover:bg-emerald-500 shadow-md shadow-emerald-600/20 transition"
      >
        <i data-lucide="download" class="w-3.5 h-3.5"></i>
        <span>Download Backup File</span>
      </a>
    </div>

    <!-- Section 2: Import Database -->
    <div class="p-4 rounded-xl bg-[#0B0E14] border border-white/6 space-y-2.5">
      <div class="flex items-center justify-between">
        <div class="text-xs font-semibold text-white flex items-center gap-2">
          <i data-lucide="upload" class="w-4 h-4 text-cyan-accent"></i>
          <span>Restore from Backup</span>
        </div>
        <span class="text-[10px] text-slate-500 font-mono">restore state</span>
      </div>
      <p class="text-[11px] text-slate-400 leading-relaxed">
        Upload an exported backup to immediately revive your bot instances and restore all module settings after updating.
      </p>
      
      <div class="flex items-center gap-2">
        <input 
          type="file" 
          id="backup-file-input" 
          accept=".json" 
          class="block w-full text-xs text-slate-400 file:mr-3 file:py-2 file:px-3 file:rounded-xl file:border-0 file:text-xs file:font-semibold file:bg-white/10 file:text-white hover:file:bg-white/15 cursor-pointer"
        >
        <button 
          type="button" 
          onclick="handleImportBackup()" 
          id="import-backup-btn" 
          class="px-4 py-2 rounded-xl text-xs font-bold text-white bg-blurple hover:bg-blurple-hover shadow-md shadow-blurple/25 transition flex items-center gap-1.5 flex-shrink-0"
        >
          <i data-lucide="check" class="w-3.5 h-3.5"></i>
          <span>Restore</span>
        </button>
      </div>
    </div>

    <!-- Section 3: Redeployment Tip -->
    <div class="p-3.5 rounded-xl bg-blurple/10 border border-blurple/20 space-y-1">
      <div class="text-xs font-semibold text-blurple flex items-center gap-1.5">
        <i data-lucide="info" class="w-3.5 h-3.5"></i>
        <span>Redeployment &amp; Update Tip</span>
      </div>
      <p class="text-[11px] text-slate-300 leading-relaxed">
        When updating OmniBots on Hostinger or VPS via Direct ZIP upload, extracting over your existing directory preserves your <code class="text-cyan-accent font-mono text-[10px]">data/</code> folder automatically!
      </p>
    </div>

    <div class="flex justify-end pt-2">
      <button 
        type="button" 
        onclick="closeBackupModal()" 
        class="px-4 py-2 rounded-xl text-xs font-semibold text-slate-400 hover:text-white bg-white/5 hover:bg-white/10 transition"
      >
        Close
      </button>
    </div>
  </div>
</div>

<script>
function openBackupModal() {
  const modal = document.getElementById('backup-modal');
  if (modal) {
    modal.classList.remove('hidden');
    if (window.lucide) window.lucide.createIcons();
  }
}

function closeBackupModal() {
  const modal = document.getElementById('backup-modal');
  if (modal) modal.classList.add('hidden');
}

async function handleImportBackup() {
  const fileInput = document.getElementById('backup-file-input');
  if (!fileInput || !fileInput.files || fileInput.files.length === 0) {
    showToast('Please select a .json backup file first.', 'error');
    return;
  }

  const file = fileInput.files[0];
  const btn = document.getElementById('import-backup-btn');
  const origText = btn.innerHTML;
  btn.disabled = true;
  btn.textContent = 'Restoring...';

  try {
    const text = await file.text();
    const payload = JSON.parse(text);

    const res = await fetch('/api/database/import', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(payload)
    });
    const data = await res.json();
    if (data.success) {
      showToast(data.message || 'Database restored successfully!', 'success');
      setTimeout(() => window.location.reload(), 1000);
    } else {
      showToast(data.error || 'Failed to restore database.', 'error');
    }
  } catch (err) {
    showToast('Invalid backup file or network error: ' + err.message, 'error');
  } finally {
    btn.disabled = false;
    btn.innerHTML = origText;
    if (window.lucide) window.lucide.createIcons();
  }
}
</script>
