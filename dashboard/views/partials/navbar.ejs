        <a href="/dashboard" class="hidden sm:flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-white/5 hover:bg-white/8 border border-white/8 hover:border-blurple/40 text-xs font-semibold text-slate-300 hover:text-white transition-all duration-150">
