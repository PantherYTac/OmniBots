<%- include('partials/head', { title: `${guild.name} • Custom Commands` }) %>
<%- include('partials/navbar') %>

<div class="flex-1 flex">
  <%- include('partials/sidebar', { tab: 'custom-commands', guild }) %>

  <main class="flex-1 p-6 sm:p-10 space-y-8 overflow-y-auto max-w-5xl">
    <div class="border-b border-[#1E2538] pb-6">
      <h1 class="text-2xl sm:text-3xl font-black text-white tracking-tight">Custom Commands & Autoresponders</h1>
      <p class="text-slate-400 text-sm mt-1">Create custom keyword triggers that send automated text responses in Discord chat.</p>
    </div>

    <!-- Create Command Form -->
    <div class="glass-card p-6 space-y-4">
      <h2 class="text-lg font-bold text-white flex items-center gap-2">
        <i data-lucide="plus-circle" class="w-5 h-5 text-blurple"></i>
        <span>Create New Custom Command</span>
      </h2>

      <form id="create-cmd-form" class="space-y-4">
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
          <div>
            <label class="block text-xs font-semibold text-slate-400 uppercase tracking-wider mb-2">Trigger Keyword</label>
            <div class="relative">
              <span class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none text-slate-500 font-mono text-sm">!</span>
              <input type="text" id="cmd_trigger" placeholder="rules" required class="w-full bg-[#0B0E14] border border-[#1E2538] rounded-xl pl-8 pr-4 py-2.5 text-white focus:outline-none focus:border-blurple text-sm font-mono">
            </div>
          </div>
          <div class="sm:col-span-2">
            <label class="block text-xs font-semibold text-slate-400 uppercase tracking-wider mb-2">Automated Response Message</label>
            <input type="text" id="cmd_response" placeholder="Please read our rules in #rules-and-info!" required class="w-full bg-[#0B0E14] border border-[#1E2538] rounded-xl px-4 py-2.5 text-white focus:outline-none focus:border-blurple text-sm">
          </div>
        </div>

        <button type="submit" class="bg-blurple hover:bg-blurple-hover text-white text-sm font-bold px-6 py-2.5 rounded-xl transition flex items-center gap-2 shadow-lg shadow-blurple/25">
          <i data-lucide="plus" class="w-4 h-4"></i>
          <span>Save Command</span>
        </button>
      </form>
    </div>

    <!-- Commands Table -->
    <div class="glass-card p-6 space-y-4">
      <h2 class="text-lg font-bold text-white flex items-center justify-between">
        <span>Active Custom Commands</span>
        <span class="text-xs text-slate-500 font-normal"><%= commands.length %> Total</span>
      </h2>

      <% if (commands.length === 0) { %>
        <div class="text-center py-10 text-slate-500 text-sm">
          No custom commands created yet. Use the form above to add your first trigger.
        </div>
      <% } else { %>
        <div class="overflow-x-auto">
          <table class="w-full text-left text-sm">
            <thead>
              <tr class="text-xs text-slate-400 border-b border-[#1E2538]">
                <th class="py-3 px-4">Trigger</th>
                <th class="py-3 px-4">Response Message</th>
                <th class="py-3 px-4 text-right">Actions</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-[#1E2538]">
              <% commands.forEach(cmd => { %>
                <tr class="hover:bg-[#181F2E]/50 transition">
                  <td class="py-3 px-4">
                    <span class="font-mono text-blurple bg-blurple/10 border border-blurple/30 px-2.5 py-1 rounded-lg text-xs font-semibold">
                      <%= cmd.trigger %>
                    </span>
                  </td>
                  <td class="py-3 px-4 text-slate-300"><%= cmd.response %></td>
                  <td class="py-3 px-4 text-right">
                    <button onclick="deleteCommand('<%= cmd.trigger %>')" class="text-slate-400 hover:text-red-400 p-2 rounded-lg hover:bg-red-500/10 transition" title="Delete Command">
                      <i data-lucide="trash-2" class="w-4 h-4"></i>
                    </button>
                  </td>
                </tr>
              <% }); %>
            </tbody>
          </table>
        </div>
      <% } %>
    </div>
  </main>
</div>

<script>
  document.getElementById('create-cmd-form')?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const trigger = document.getElementById('cmd_trigger').value.trim();
    const response = document.getElementById('cmd_response').value.trim();

    try {
      const res = await fetch('/api/guilds/<%= guild.id %>/custom-commands', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ trigger, response })
      });
      const data = await res.json();
      if (res.ok && data.success) {
        showToast('Command created successfully!');
        setTimeout(() => location.reload(), 600);
      } else {
        showToast(data.error || 'Failed to save command', 'error');
      }
    } catch (err) {
      showToast('Network error', 'error');
    }
  });

  async function deleteCommand(trigger) {
    if (!confirm(`Are you sure you want to delete command "${trigger}"?`)) return;
    try {
      const res = await fetch(`/api/guilds/<%= guild.id %>/custom-commands/${encodeURIComponent(trigger)}`, {
        method: 'DELETE'
      });
      const data = await res.json();
      if (res.ok && data.success) {
        showToast('Command deleted.');
        setTimeout(() => location.reload(), 600);
      } else {
        showToast(data.error || 'Failed to delete command', 'error');
      }
    } catch (err) {
      showToast('Network error', 'error');
    }
  }
</script>

<%- include('partials/footer') %>
