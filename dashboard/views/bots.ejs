<%- include('partials/head', { title: 'Multi-Bot Hub • OmniBots' }) %>

<body class="bg-[#0B0E14] text-slate-200 min-h-screen flex flex-col antialiased selection:bg-blurple selection:text-white">

  <%- include('partials/navbar') %>

  <!-- Main Container -->
  <main class="flex-1 max-w-7xl w-full mx-auto p-6 md:p-8 space-y-8">

    <!-- Top Banner & Actions -->
    <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 border-b border-white/5 pb-5 mb-6">
      <div>
        <div class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full text-[11px] font-semibold bg-cyan-accent/10 text-cyan-accent border border-cyan-accent/30 mb-2">
          <i data-lucide="cpu" class="w-3.5 h-3.5"></i>
          <span>Multi-Bot Orchestration Engine</span>
        </div>
        <h1 class="text-2xl md:text-3xl font-extrabold text-white tracking-tight">Multi-Bot Fleet Hub</h1>
        <p class="text-sm text-slate-500 mt-1">Concurrently run, monitor, and sync multiple Discord bots from a single unified control plane.</p>
      </div>

      <div class="flex flex-wrap items-center gap-3">
        <button 
          onclick="openOAuthModal()" 
          class="bg-[#0D1117] hover:bg-white/5 border border-white/8 hover:border-white/15 text-slate-300 hover:text-white font-semibold text-sm px-4 py-2 rounded-xl transition flex items-center gap-2"
        >
          <i data-lucide="link" class="w-4 h-4 text-blurple"></i>
          <span>Discord OAuth &amp; Linking</span>
        </button>

        <button 
          onclick="openAddBotModal()" 
          class="bg-gradient-to-r from-blurple to-indigo-600 hover:from-blurple-hover hover:to-indigo-500 text-white font-semibold text-sm px-4 py-2 rounded-xl shadow-lg shadow-blurple/25 transition flex items-center gap-2 transform hover:-translate-y-0.5 active:translate-y-0"
        >
          <i data-lucide="plus" class="w-4 h-4"></i>
          <span>Add New Discord Bot</span>
        </button>
      </div>
    </div>

    <!-- Alert / Notice Banners -->
    <% if (typeof notice !== 'undefined' && notice) { %>
      <div class="p-4 rounded-xl bg-cyan-accent/10 border border-cyan-accent/30 text-cyan-accent text-sm font-semibold flex items-center gap-3">
        <i data-lucide="info" class="w-5 h-5 flex-shrink-0"></i>
        <span><%= notice %></span>
      </div>
    <% } %>

    <% if (typeof error !== 'undefined' && error) { %>
      <div class="p-4 rounded-xl bg-red-500/10 border border-red-500/30 text-red-400 text-sm font-semibold flex items-center gap-3">
        <i data-lucide="alert-circle" class="w-5 h-5 flex-shrink-0"></i>
        <span><%= error %></span>
      </div>
    <% } %>

    <!-- Metric Overview Cards -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
      <!-- Total Bots -->
      <div class="relative overflow-hidden bg-[#0D1117] border border-white/6 rounded-2xl p-5 flex items-center justify-between">
        <div class="absolute left-0 inset-y-0 w-[3px] bg-gradient-to-b from-blurple to-indigo-600 rounded-r"></div>
        <div>
          <div class="text-xs font-semibold text-slate-400 uppercase tracking-wider">Total Bots</div>
          <div class="text-2xl font-black text-white mt-1"><%= bots.length %></div>
        </div>
        <div class="w-11 h-11 rounded-xl bg-blurple/15 border border-blurple/30 flex items-center justify-center text-blurple">
          <i data-lucide="bot" class="w-5 h-5"></i>
        </div>
      </div>

      <!-- Active & Online -->
      <div class="relative overflow-hidden bg-[#0D1117] border border-white/6 rounded-2xl p-5 flex items-center justify-between">
        <div class="absolute left-0 inset-y-0 w-[3px] bg-gradient-to-b from-emerald-500 to-emerald-700 rounded-r"></div>
        <div>
          <div class="text-xs font-semibold text-slate-400 uppercase tracking-wider">Active &amp; Online</div>
          <div class="text-2xl font-black text-emerald-400 mt-1">
            <%= bots.filter(b => b.status === 'online').length %>
          </div>
        </div>
        <div class="w-11 h-11 rounded-xl bg-emerald-500/15 border border-emerald-500/30 flex items-center justify-center text-emerald-400">
          <i data-lucide="activity" class="w-5 h-5"></i>
        </div>
      </div>

      <!-- Servers Protected -->
      <div class="relative overflow-hidden bg-[#0D1117] border border-white/6 rounded-2xl p-5 flex items-center justify-between">
        <div class="absolute left-0 inset-y-0 w-[3px] bg-gradient-to-b from-[#38BDF8] to-cyan-700 rounded-r"></div>
        <div>
          <div class="text-xs font-semibold text-slate-400 uppercase tracking-wider">Servers Protected</div>
          <div class="text-2xl font-black text-cyan-accent mt-1">
            <%= bots.reduce((sum, b) => sum + (b.guildsCount || 0), 0) %>
          </div>
        </div>
        <div class="w-11 h-11 rounded-xl bg-cyan-accent/15 border border-cyan-accent/30 flex items-center justify-center text-cyan-accent">
          <i data-lucide="shield" class="w-5 h-5"></i>
        </div>
      </div>

      <!-- Users Served -->
      <div class="relative overflow-hidden bg-[#0D1117] border border-white/6 rounded-2xl p-5 flex items-center justify-between">
        <div class="absolute left-0 inset-y-0 w-[3px] bg-gradient-to-b from-indigo-400 to-indigo-700 rounded-r"></div>
        <div>
          <div class="text-xs font-semibold text-slate-400 uppercase tracking-wider">Users Served</div>
          <div class="text-2xl font-black text-indigo-400 mt-1">
            <%= bots.reduce((sum, b) => sum + (b.usersCount || 0), 0).toLocaleString() %>
          </div>
        </div>
        <div class="w-11 h-11 rounded-xl bg-indigo-500/15 border border-indigo-500/30 flex items-center justify-center text-indigo-400">
          <i data-lucide="users" class="w-5 h-5"></i>
        </div>
      </div>
    </div>

    <!-- Bots List -->
    <div class="space-y-4">
      <h2 class="text-sm font-semibold text-white flex items-center gap-2">
        <i data-lucide="layers" class="w-4 h-4 text-blurple"></i>
        <span>Managed Bot Instances</span>
      </h2>

      <% if (bots.length === 0) { %>
        <div class="bg-[#0D1117] border border-white/6 rounded-2xl p-12 text-center space-y-4">
          <div class="w-16 h-16 rounded-2xl bg-blurple/10 border border-blurple/20 flex items-center justify-center text-blurple mx-auto">
            <i data-lucide="bot" class="w-8 h-8"></i>
          </div>
          <div class="max-w-md mx-auto space-y-2">
            <h3 class="text-sm font-semibold text-white">No Discord Bots Connected</h3>
            <p class="text-xs text-slate-500">Add your first bot token to start managing slash commands, server moderation, and modules with OmniBots.</p>
          </div>
          <button onclick="openAddBotModal()" class="bg-blurple hover:bg-blurple-hover text-white font-semibold text-sm px-5 py-2.5 rounded-xl shadow-lg shadow-blurple/25 transition inline-flex items-center gap-2">
            <i data-lucide="plus" class="w-4 h-4"></i>
            <span>Add Your First Bot</span>
          </button>
        </div>
      <% } else { %>
        <div class="grid grid-cols-1 gap-4">
          <% bots.forEach(bot => { %>
            <div class="bg-[#0D1117] border border-white/6 rounded-2xl p-5 hover:border-white/10 transition-all duration-200 space-y-5" id="bot_card_<%= bot.id %>">
              <div class="flex flex-col md:flex-row md:items-center justify-between gap-4">
                <!-- Bot Info Left -->
                <div class="flex items-center gap-4">
                  <!-- Bot Avatar -->
                  <div class="relative">
                    <% if (bot.avatar) { %>
                      <img 
                        src="<%= bot.avatar %>" 
                        alt="<%= bot.name %>" 
                        class="w-12 h-12 rounded-xl object-cover border border-white/8"
                      >
                    <% } else { %>
                      <div class="w-12 h-12 rounded-xl bg-gradient-to-br from-blurple to-indigo-600 border border-blurple/30 flex items-center justify-center text-white font-bold text-lg select-none">
                        <%= (bot.name || 'B').charAt(0).toUpperCase() %>
                      </div>
                    <% } %>
                    <!-- Status dot -->
                    <span class="absolute -bottom-1 -right-1 w-3.5 h-3.5 rounded-full border-2 border-[#0D1117] <%= bot.status === 'online' ? 'bg-emerald-400' : (bot.status === 'starting' ? 'bg-amber-400' : 'bg-red-400') %>"></span>
                  </div>

                  <div class="space-y-1">
                    <div class="flex items-center gap-2 flex-wrap">
                      <h3 class="text-base font-bold text-white"><%= bot.name %></h3>
                      <!-- Status badge pill -->
                      <span class="text-[11px] font-semibold px-2.5 py-0.5 rounded-full border <%= bot.status === 'online' ? 'bg-emerald-500/10 text-emerald-400 border-emerald-500/20' : (bot.status === 'starting' ? 'bg-amber-500/10 text-amber-400 border-amber-500/20' : 'bg-red-500/10 text-red-400 border-red-500/20') %>">
                        <span class="inline-block w-1.5 h-1.5 rounded-full mr-1 align-middle <%= bot.status === 'online' ? 'bg-emerald-400' : (bot.status === 'starting' ? 'bg-amber-400' : 'bg-red-400') %>"></span><%= bot.status %>
                      </span>
                      <% if (bot.id === 'primary') { %>
                        <span class="text-[11px] font-semibold px-2.5 py-0.5 rounded-full bg-blurple/10 text-blurple border border-blurple/20">Primary</span>
                      <% } %>
                    </div>
                    <div class="text-xs text-slate-400 flex items-center gap-3">
                      <span>Tag: <strong class="text-slate-300"><%= bot.tag || 'Unknown' %></strong></span>
                      <span>•</span>
                      <span>ID: <code class="text-slate-300"><%= bot.clientId || bot.id %></code></span>
                    </div>
                  </div>
                </div>

                <!-- Bot Metrics Middle -->
                <div class="flex items-center gap-6 px-4 py-2 rounded-xl bg-[#0B0E14] border border-white/6 text-xs">
                  <div>
                    <div class="text-slate-500 uppercase font-semibold text-[10px]">Servers</div>
                    <div class="text-white font-bold text-sm"><%= bot.guildsCount || 0 %></div>
                  </div>
                  <div class="w-px h-6 bg-white/6"></div>
                  <div>
                    <div class="text-slate-500 uppercase font-semibold text-[10px]">Users</div>
                    <div class="text-white font-bold text-sm"><%= (bot.usersCount || 0).toLocaleString() %></div>
                  </div>
                </div>

                <!-- Bot Action Buttons Right -->
                <div class="flex items-center gap-2 flex-wrap">
                  <% if (bot.status === 'online') { %>
                    <button 
                      onclick="stopBot('<%= bot.id %>')" 
                      class="rounded-lg text-xs font-semibold px-3 py-1.5 bg-amber-500/10 hover:bg-amber-500/20 text-amber-400 border border-amber-500/20 transition flex items-center gap-1.5"
                    >
                      <i data-lucide="square" class="w-3.5 h-3.5"></i>
                      <span>Stop</span>
                    </button>
                    <button 
                      onclick="restartBot('<%= bot.id %>')" 
                      class="rounded-lg text-xs font-semibold px-3 py-1.5 bg-white/5 hover:bg-white/10 text-slate-200 border border-white/6 transition flex items-center gap-1.5"
                    >
                      <i data-lucide="rotate-cw" class="w-3.5 h-3.5"></i>
                      <span>Restart</span>
                    </button>
                  <% } else { %>
                    <button 
                      onclick="startBot('<%= bot.id %>')" 
                      class="rounded-lg text-xs font-semibold px-3 py-1.5 bg-emerald-500/10 hover:bg-emerald-500/20 text-emerald-400 border border-emerald-500/20 transition flex items-center gap-1.5"
                    >
                      <i data-lucide="play" class="w-3.5 h-3.5"></i>
                      <span>Start</span>
                    </button>
                  <% } %>

                  <button 
                    onclick="syncSlashCommands('<%= bot.id %>')" 
                    class="rounded-lg text-xs font-semibold px-3 py-1.5 bg-blurple/10 hover:bg-blurple/20 text-blurple border border-blurple/20 transition flex items-center gap-1.5"
                    title="Force sync universal slash commands to Discord application"
                  >
                    <i data-lucide="refresh-cw" class="w-3.5 h-3.5"></i>
                    <span>Sync Slash (/)</span>
                  </button>

                  <% if (bot.id !== 'primary') { %>
                    <button 
                      onclick="deleteBot('<%= bot.id %>')" 
                      class="rounded-lg p-2 bg-red-500/10 hover:bg-red-500/20 text-red-400 border border-red-500/20 transition"
                      title="Delete bot from panel"
                    >
                      <i data-lucide="trash-2" class="w-3.5 h-3.5"></i>
                    </button>
                  <% } %>
                </div>
              </div>

              <!-- Privileged Intent Warning Banner (If Disallowed Intents Detected) -->
              <% if (bot.hasIntentError) { %>
                <div class="p-4 rounded-xl bg-amber-500/10 border border-amber-500/30 text-amber-300 text-xs space-y-2">
                  <div class="flex items-center gap-2 font-bold text-amber-200">
                    <i data-lucide="alert-triangle" class="w-4 h-4 flex-shrink-0"></i>
                    <span>⚠ Privileged Gateway Intents Missing</span>
                  </div>
                  <p class="text-slate-300 leading-relaxed">
                    This bot failed to connect with privileged intents: <code><%= bot.intentErrorMessage || 'Disallowed intents' %></code>.
                    To enable moderation, welcomer, auto-mod, and prefix commands, you must enable all 3 Privileged Gateway Intents in Discord's Developer Portal:
                  </p>
                  <div class="flex flex-wrap items-center gap-2 pt-1">
                    <span class="text-[11px] font-semibold px-2.5 py-0.5 rounded-full bg-amber-500/20 text-amber-300 border border-amber-500/30 font-mono">Message Content Intent</span>
                    <span class="text-[11px] font-semibold px-2.5 py-0.5 rounded-full bg-amber-500/20 text-amber-300 border border-amber-500/30 font-mono">Server Members Intent</span>
                    <span class="text-[11px] font-semibold px-2.5 py-0.5 rounded-full bg-amber-500/20 text-amber-300 border border-amber-500/30 font-mono">Presence Intent</span>
                    <a 
                      href="https://discord.com/developers/applications/<%= bot.clientId %>/bot" 
                      target="_blank" 
                      class="ml-auto inline-flex items-center gap-1 text-cyan-accent hover:underline font-semibold text-[11px]"
                    >
                      <span>Open Developer Portal</span>
                      <i data-lucide="external-link" class="w-3 h-3"></i>
                    </a>
                  </div>
                </div>
              <% } %>
            </div>
          <% }); %>
        </div>
      <% } %>
    </div>
  </main>

  <!-- Add Bot Modal -->
  <div id="add_bot_modal" class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/75 backdrop-blur-sm hidden">
    <div class="bg-[#0D1117] border border-white/8 rounded-2xl p-6 w-full max-w-lg space-y-5 shadow-2xl shadow-black/60 animate-fade-in relative">
      <div class="flex items-center justify-between border-b border-white/5 pb-4">
        <div class="flex items-center gap-2 text-white font-bold text-base">
          <i data-lucide="bot" class="w-5 h-5 text-blurple"></i>
          <span>Add Discord Bot Instance</span>
        </div>
        <button onclick="closeAddBotModal()" class="text-slate-400 hover:text-white transition rounded-lg p-1 hover:bg-white/5">
          <i data-lucide="x" class="w-5 h-5"></i>
        </button>
      </div>

      <div class="text-xs text-slate-400 space-y-1">
        <p>Enter your Discord Bot Token. Your token is encrypted using <strong>AES-256-GCM</strong> before being safely stored.</p>
        <p class="text-slate-500">Find your token at: <a href="https://discord.com/developers/applications" target="_blank" class="text-cyan-accent hover:underline">Discord Developer Portal &gt; Your App &gt; Bot &gt; Reset Token</a></p>
      </div>

      <form id="add_bot_form" class="space-y-4">
        <div>
          <label class="block text-xs font-semibold text-slate-400 uppercase tracking-wider mb-2">Bot Custom Display Name (Optional)</label>
          <input 
            type="text" 
            id="new_bot_name" 
            placeholder="e.g. Server Protector" 
            class="w-full bg-[#0B0E14] border border-white/8 rounded-xl px-3.5 py-2.5 text-sm text-white placeholder-slate-600 focus:border-blurple/60 focus:ring-2 focus:ring-blurple/10 outline-none transition"
          >
        </div>

        <div>
          <label class="block text-xs font-semibold text-slate-400 uppercase tracking-wider mb-2">Bot Token</label>
          <div class="relative">
            <input 
              type="password" 
              id="new_bot_token" 
              required 
              placeholder="Paste bot token here..." 
              class="w-full bg-[#0B0E14] border border-white/8 rounded-xl px-3.5 pr-11 py-2.5 text-sm text-white placeholder-slate-600 font-mono focus:border-blurple/60 focus:ring-2 focus:ring-blurple/10 outline-none transition"
            >
            <button 
              type="button" 
              id="toggle_bot_token_btn" 
              class="absolute inset-y-0 right-0 pr-3.5 flex items-center text-slate-500 hover:text-slate-300 transition"
            >
              <i data-lucide="eye" class="w-4 h-4"></i>
            </button>
          </div>
        </div>

        <div id="add_bot_error" class="hidden p-3 rounded-xl bg-red-500/10 border border-red-500/20 text-red-400 text-xs"></div>

        <div class="flex items-center justify-end gap-3 pt-2">
          <button 
            type="button" 
            onclick="closeAddBotModal()" 
            class="px-4 py-2 rounded-xl bg-white/5 hover:bg-white/10 text-slate-300 text-sm font-semibold transition"
          >
            Cancel
          </button>
          <button 
            type="submit" 
            id="add_bot_submit_btn" 
            class="px-5 py-2 rounded-xl bg-gradient-to-r from-blurple to-indigo-600 hover:from-blurple-hover hover:to-indigo-500 text-white text-sm font-semibold transition flex items-center gap-2 shadow-lg shadow-blurple/25"
          >
            <i data-lucide="check" class="w-4 h-4"></i>
            <span>Connect &amp; Start Bot</span>
          </button>
        </div>
      </form>
    </div>
  </div>

  <%- include('partials/footer') %>

  <script>
    function openAddBotModal() {
      document.getElementById('add_bot_modal').classList.remove('hidden');
      document.getElementById('add_bot_error').classList.add('hidden');
    }

    function closeAddBotModal() {
      document.getElementById('add_bot_modal').classList.add('hidden');
    }

    // Toggle token visibility
    const tokenInput = document.getElementById('new_bot_token');
    const toggleTokenBtn = document.getElementById('toggle_bot_token_btn');
    if (toggleTokenBtn && tokenInput) {
      toggleTokenBtn.addEventListener('click', () => {
        const isPass = tokenInput.type === 'password';
        tokenInput.type = isPass ? 'text' : 'password';
        toggleTokenBtn.innerHTML = isPass ? '<i data-lucide="eye-off" class="w-4 h-4"></i>' : '<i data-lucide="eye" class="w-4 h-4"></i>';
        if (window.lucide) window.lucide.createIcons();
      });
    }

    // Form submit: Add bot
    document.getElementById('add_bot_form').addEventListener('submit', async (e) => {
      e.preventDefault();
      const token = document.getElementById('new_bot_token').value.trim();
      const name = document.getElementById('new_bot_name').value.trim();
      const btn = document.getElementById('add_bot_submit_btn');
      const errBox = document.getElementById('add_bot_error');

      if (!token) return;

      btn.disabled = true;
      btn.innerHTML = '<i data-lucide="loader-2" class="w-4 h-4 animate-spin"></i><span>Verifying Token...</span>';
      if (window.lucide) window.lucide.createIcons();

      try {
        const res = await fetch('/api/bots', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ token, name })
        });
        const data = await res.json();

        if (data.success) {
          window.location.reload();
        } else {
          errBox.textContent = data.error || 'Failed to add bot.';
          errBox.classList.remove('hidden');
          btn.disabled = false;
          btn.innerHTML = '<i data-lucide="check" class="w-4 h-4"></i><span>Connect & Start Bot</span>';
          if (window.lucide) window.lucide.createIcons();
        }
      } catch (err) {
        errBox.textContent = 'Network or server error verifying bot token.';
        errBox.classList.remove('hidden');
        btn.disabled = false;
        btn.innerHTML = '<i data-lucide="check" class="w-4 h-4"></i><span>Connect & Start Bot</span>';
        if (window.lucide) window.lucide.createIcons();
      }
    });

    async function startBot(botId) {
      try {
        const res = await fetch(`/api/bots/${botId}/start`, { method: 'POST' });
        const data = await res.json();
        if (data.success) window.location.reload();
        else alert(data.error || 'Failed to start bot');
      } catch {
        alert('Network error communicating with server');
      }
    }

    async function stopBot(botId) {
      if (!confirm('Are you sure you want to stop this bot instance?')) return;
      try {
        const res = await fetch(`/api/bots/${botId}/stop`, { method: 'POST' });
        const data = await res.json();
        if (data.success) window.location.reload();
        else alert(data.error || 'Failed to stop bot');
      } catch {
        alert('Network error communicating with server');
      }
    }

    async function restartBot(botId) {
      try {
        const res = await fetch(`/api/bots/${botId}/restart`, { method: 'POST' });
        const data = await res.json();
        if (data.success) window.location.reload();
        else alert(data.error || 'Failed to restart bot');
      } catch {
        alert('Network error communicating with server');
      }
    }

    async function syncSlashCommands(botId) {
      try {
        const res = await fetch(`/api/bots/${botId}/sync-commands`, { method: 'POST' });
        const data = await res.json();
        if (data.success) {
          alert(`Success! Registered ${data.count} global application commands with Discord!`);
        } else {
          alert('Failed to sync commands: ' + (data.error || 'Unknown error'));
        }
      } catch {
        alert('Network error syncing slash commands');
      }
    }

    async function deleteBot(botId) {
      if (!confirm('Are you sure you want to permanently remove this bot from your OmniBots panel?')) return;
      try {
        const res = await fetch(`/api/bots/${botId}`, { method: 'DELETE' });
        const data = await res.json();
        if (data.success) window.location.reload();
        else alert(data.error || 'Failed to delete bot');
      } catch {
        alert('Network error communicating with server');
      }
    }
  </script>
  <%- include('partials/oauth-modal') %>
</body>
</html>
