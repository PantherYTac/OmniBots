<%- include('partials/head', { title: `${guild.name} • Auto-Mod & Rules` }) %>
<%- include('partials/navbar') %>

<div class="flex-1 flex">
  <%- include('partials/sidebar', { tab: 'automod', guild }) %>

  <main class="flex-1 p-6 sm:p-10 space-y-8 overflow-y-auto max-w-5xl">
    <div class="border-b border-[#1E2538] pb-6">
      <h1 class="text-2xl sm:text-3xl font-black text-white tracking-tight">Auto-Moderation & Rule Engine</h1>
      <p class="text-slate-400 text-sm mt-1">Carl-bot style real-time message filtering, anti-spam, and infraction escalation.</p>
    </div>

    <% const automod = settings.automod || {}; %>
    <form action="/api/guilds/<%= guild.id %>/automod" method="POST" class="ajax-save-form space-y-8">
      <!-- Rule Filters Card -->
      <div class="glass-card p-6 space-y-6">
        <h2 class="text-lg font-bold text-white flex items-center gap-2">
          <i data-lucide="shield-check" class="w-5 h-5 text-blurple"></i>
          <span>Real-time Filters</span>
        </h2>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <!-- Anti Invites -->
          <div class="p-4 rounded-xl bg-[#0B0E14] border border-[#1E2538] flex items-center justify-between">
            <div>
              <div class="text-sm font-semibold text-white">Block Discord Invites</div>
              <div class="text-xs text-slate-400">Deletes unauthorized discord.gg / discord.com invite links</div>
            </div>
            <label class="relative inline-flex items-center cursor-pointer flex-shrink-0 ml-3">
              <input type="checkbox" name="antiInvites" class="sr-only peer" <%= automod.antiInvites ? 'checked' : '' %>>
              <div class="w-11 h-6 bg-slate-700 peer-focus:outline-none rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-slate-300 after:border after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:bg-blurple"></div>
            </label>
          </div>

          <!-- Anti External Links -->
          <div class="p-4 rounded-xl bg-[#0B0E14] border border-[#1E2538] flex items-center justify-between">
            <div>
              <div class="text-sm font-semibold text-white">Block External Links</div>
              <div class="text-xs text-slate-400">Deletes all http:// and https:// external hyperlinks</div>
            </div>
            <label class="relative inline-flex items-center cursor-pointer flex-shrink-0 ml-3">
              <input type="checkbox" name="antiLinks" class="sr-only peer" <%= automod.antiLinks ? 'checked' : '' %>>
              <div class="w-11 h-6 bg-slate-700 peer-focus:outline-none rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-slate-300 after:border after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:bg-blurple"></div>
            </label>
          </div>

          <!-- Anti-Spam Flood -->
          <div class="p-4 rounded-xl bg-[#0B0E14] border border-[#1E2538] flex items-center justify-between">
            <div>
              <div class="text-sm font-semibold text-white">Anti-Spam Flooding</div>
              <div class="text-xs text-slate-400">Prevents rapid burst messaging (> 5 messages in 4 seconds)</div>
            </div>
            <label class="relative inline-flex items-center cursor-pointer flex-shrink-0 ml-3">
              <input type="checkbox" name="antiSpam" class="sr-only peer" <%= automod.antiSpam ? 'checked' : '' %>>
              <div class="w-11 h-6 bg-slate-700 peer-focus:outline-none rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-slate-300 after:border after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:bg-blurple"></div>
            </label>
          </div>

          <!-- Sticky Roles Toggle -->
          <div class="p-4 rounded-xl bg-[#0B0E14] border border-[#1E2538] flex items-center justify-between">
            <div>
              <div class="text-sm font-semibold text-white">Sticky Roles</div>
              <div class="text-xs text-slate-400">Automatically restores roles if a member leaves and rejoins</div>
            </div>
            <label class="relative inline-flex items-center cursor-pointer flex-shrink-0 ml-3">
              <input type="checkbox" name="stickyRolesEnabled" class="sr-only peer" <%= (settings.stickyRoles && settings.stickyRoles.enabled) ? 'checked' : '' %>>
              <div class="w-11 h-6 bg-slate-700 peer-focus:outline-none rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-slate-300 after:border after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:bg-blurple"></div>
            </label>
          </div>
        </div>

        <!-- Mentions & Emoji Thresholds -->
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-6 pt-4 border-t border-[#1E2538]">
          <div>
            <label class="block text-xs font-semibold text-slate-400 uppercase tracking-wider mb-2">
              Mass Mention Limit (Max Mentions per message)
            </label>
            <input type="number" name="mentionThreshold" value="<%= automod.mentionThreshold || 5 %>" min="1" max="50" class="w-full bg-[#0B0E14] border border-[#1E2538] rounded-xl px-4 py-2.5 text-white focus:outline-none focus:border-blurple text-sm">
          </div>

          <div>
            <label class="block text-xs font-semibold text-slate-400 uppercase tracking-wider mb-2">
              Emoji Spam Limit (Max Emojis per message)
            </label>
            <input type="number" name="emojiThreshold" value="<%= automod.emojiThreshold || 8 %>" min="1" max="100" class="w-full bg-[#0B0E14] border border-[#1E2538] rounded-xl px-4 py-2.5 text-white focus:outline-none focus:border-blurple text-sm">
          </div>
        </div>
      </div>

      <!-- Banned Words List -->
      <div class="glass-card p-6 space-y-4">
        <div>
          <h2 class="text-lg font-bold text-white flex items-center gap-2">
            <i data-lucide="ban" class="w-5 h-5 text-red-400"></i>
            <span>Banned Words & Phrases</span>
          </h2>
          <p class="text-xs text-slate-400 mt-1">Enter banned keywords separated by commas or newlines. Messages containing these will be automatically filtered.</p>
        </div>

        <textarea name="bannedWords" rows="4" placeholder="discord.gg/scam, free-nitro, grabify, badword" class="w-full bg-[#0B0E14] border border-[#1E2538] rounded-xl p-4 text-white focus:outline-none focus:border-blurple text-sm font-mono"><%= (automod.bannedWords || []).join(', ') %></textarea>
      </div>

      <!-- Auto-Escalation Thresholds -->
      <div class="glass-card p-6 space-y-6">
        <div>
          <h2 class="text-lg font-bold text-white flex items-center gap-2">
            <i data-lucide="alert-triangle" class="w-5 h-5 text-yellow-400"></i>
            <span>Auto-Escalation Thresholds</span>
          </h2>
          <p class="text-xs text-slate-400 mt-1">Automatically trigger disciplinary punishments when a user reaches warning thresholds.</p>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
          <div class="p-4 rounded-xl bg-[#0B0E14] border border-[#1E2538] space-y-2">
            <div class="text-sm font-bold text-white">Tier 1 Escalation</div>
            <div class="text-xs text-slate-400">3 Warnings: 1 Hour Timeout</div>
            <div class="text-xs text-emerald-400 font-medium">Active (Automatic)</div>
          </div>

          <div class="p-4 rounded-xl bg-[#0B0E14] border border-[#1E2538] space-y-2">
            <div class="text-sm font-bold text-white">Tier 2 Escalation</div>
            <div class="text-xs text-slate-400">5 Warnings: Server Kick</div>
            <div class="text-xs text-emerald-400 font-medium">Active (Automatic)</div>
          </div>

          <div class="p-4 rounded-xl bg-[#0B0E14] border border-[#1E2538] space-y-2">
            <div class="text-sm font-bold text-white">Tier 3 Escalation</div>
            <div class="text-xs text-slate-400">7 Warnings: Permanent Ban</div>
            <div class="text-xs text-emerald-400 font-medium">Active (Automatic)</div>
          </div>
        </div>
      </div>

      <!-- Save Bar -->
      <div class="glass-card p-4 flex items-center justify-between sticky bottom-6 shadow-2xl z-20">
        <span class="text-xs text-slate-400 flex items-center gap-1.5">
          <i data-lucide="info" class="w-4 h-4 text-blurple"></i>
          Settings sync instantly to the bot worker.
        </span>
        <button type="submit" class="bg-blurple hover:bg-blurple-hover text-white text-sm font-bold px-6 py-2.5 rounded-xl transition flex items-center gap-2 shadow-lg shadow-blurple/25">
          <i data-lucide="save" class="w-4 h-4"></i>
          <span>Save AutoMod Rules</span>
        </button>
      </div>
    </form>
  </main>
</div>

<%- include('partials/footer') %>
