<%- include('partials/head', { title: `${guild.name} • Leveling & Economy` }) %>
<%- include('partials/navbar') %>

<div class="flex-1 flex">
  <%- include('partials/sidebar', { tab: 'leveling', guild }) %>

  <main class="flex-1 p-6 sm:p-10 space-y-8 overflow-y-auto max-w-5xl">
    <div class="border-b border-[#1E2538] pb-6">
      <h1 class="text-2xl sm:text-3xl font-black text-white tracking-tight">Leveling & Server Shop Manager</h1>
      <p class="text-slate-400 text-sm mt-1">Configure XP multipliers, automatic level role rewards, and economy store items.</p>
    </div>

    <% const leveling = settings.leveling || {}; %>
    <!-- Leveling Settings Form -->
    <form action="/api/guilds/<%= guild.id %>/leveling" method="POST" class="ajax-save-form space-y-6">
      <div class="glass-card p-6 space-y-6">
        <h2 class="text-lg font-bold text-white flex items-center gap-2">
          <i data-lucide="award" class="w-5 h-5 text-yellow-400"></i>
          <span>Leveling & XP Progression</span>
        </h2>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
          <div>
            <label class="block text-xs font-semibold text-slate-400 uppercase tracking-wider mb-2">XP Multiplier Rate</label>
            <input type="number" step="0.1" name="xpRate" value="<%= leveling.xpRate || 1.0 %>" min="0.1" max="10.0" class="w-full bg-[#0B0E14] border border-[#1E2538] rounded-xl px-4 py-2.5 text-white focus:outline-none focus:border-blurple text-sm">
          </div>

          <div>
            <label class="block text-xs font-semibold text-slate-400 uppercase tracking-wider mb-2">Announcement Channel</label>
            <select name="announcementChannelId" class="w-full bg-[#0B0E14] border border-[#1E2538] rounded-xl px-4 py-2.5 text-white focus:outline-none focus:border-blurple text-sm">
              <option value="">Current Channel (Where member spoke)</option>
              <% channels.forEach(ch => { %>
                <option value="<%= ch.id %>" <%= leveling.announcementChannelId === ch.id ? 'selected' : '' %>># <%= ch.name %></option>
              <% }); %>
            </select>
          </div>
        </div>

        <div>
          <label class="block text-xs font-semibold text-slate-400 uppercase tracking-wider mb-2">Level-Up Announcement Message</label>
          <input type="text" name="levelMessage" value="<%= leveling.message || 'Congratulations {user}, you leveled up to **Level {level}**! 🚀' %>" class="w-full bg-[#0B0E14] border border-[#1E2538] rounded-xl px-4 py-2.5 text-white focus:outline-none focus:border-blurple text-sm">
        </div>

        <button type="submit" class="bg-blurple hover:bg-blurple-hover text-white text-sm font-bold px-6 py-2.5 rounded-xl transition flex items-center gap-2 shadow-lg shadow-blurple/25">
          <i data-lucide="save" class="w-4 h-4"></i>
          <span>Save Leveling Settings</span>
        </button>
      </div>
    </form>

    <!-- Level Role Rewards Manager -->
    <div class="glass-card p-6 space-y-6">
      <h2 class="text-lg font-bold text-white flex items-center gap-2">
        <i data-lucide="shield" class="w-5 h-5 text-blurple"></i>
        <span>Automatic Level Role Rewards</span>
      </h2>

      <!-- Add Level Role Form -->
      <form id="add-level-role-form" class="grid grid-cols-1 sm:grid-cols-3 gap-4">
        <div>
          <label class="block text-xs font-semibold text-slate-400 uppercase tracking-wider mb-2">Target Level</label>
          <input type="number" id="lr_level" min="1" max="1000" placeholder="5" required class="w-full bg-[#0B0E14] border border-[#1E2538] rounded-xl px-4 py-2.5 text-white focus:outline-none focus:border-blurple text-sm">
        </div>
        <div>
          <label class="block text-xs font-semibold text-slate-400 uppercase tracking-wider mb-2">Award Role</label>
          <select id="lr_role" required class="w-full bg-[#0B0E14] border border-[#1E2538] rounded-xl px-4 py-2.5 text-white focus:outline-none focus:border-blurple text-sm">
            <% roles.forEach(r => { %>
              <option value="<%= r.id %>">@<%= r.name %></option>
            <% }); %>
          </select>
        </div>
        <div class="flex items-end">
          <button type="submit" class="w-full bg-[#1E2538] hover:bg-blurple text-white text-sm font-semibold py-2.5 rounded-xl transition flex items-center justify-center gap-2">
            <i data-lucide="plus" class="w-4 h-4"></i>
            <span>Add Level Reward</span>
          </button>
        </div>
      </form>

      <!-- Level Roles Table -->
      <div class="overflow-x-auto">
        <table class="w-full text-left text-sm">
          <thead>
            <tr class="text-xs text-slate-400 border-b border-[#1E2538]">
              <th class="py-2.5 px-3">Level Required</th>
              <th class="py-2.5 px-3">Role Awarded</th>
              <th class="py-2.5 px-3 text-right">Action</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-[#1E2538]">
            <% const levelRoles = leveling.levelRoles || []; %>
            <% if (levelRoles.length === 0) { %>
              <tr>
                <td colspan="3" class="py-4 text-center text-slate-500 text-xs">No level role rewards configured yet.</td>
              </tr>
            <% } else { %>
              <% levelRoles.forEach(lr => { %>
                <% const r = roles.find(role => role.id === lr.roleId); %>
                <tr class="hover:bg-[#181F2E]/50">
                  <td class="py-3 px-3 font-bold text-white">Level <%= lr.level %></td>
                  <td class="py-3 px-3 text-blurple">@<%= r ? r.name : lr.roleId %></td>
                  <td class="py-3 px-3 text-right">
                    <button onclick="deleteLevelRole('<%= lr.level %>')" class="text-slate-400 hover:text-red-400 p-1.5 rounded transition">
                      <i data-lucide="trash-2" class="w-4 h-4"></i>
                    </button>
                  </td>
                </tr>
              <% }); %>
            <% } %>
          </tbody>
        </table>
      </div>
    </div>

    <!-- Server Shop Manager -->
    <div class="glass-card p-6 space-y-6">
      <h2 class="text-lg font-bold text-white flex items-center gap-2">
        <i data-lucide="shopping-bag" class="w-5 h-5 text-emerald-400"></i>
        <span>Server Shop Items & Prices</span>
      </h2>

      <!-- Add Shop Item Form -->
      <form id="add-shop-item-form" class="grid grid-cols-1 sm:grid-cols-4 gap-4">
        <div>
          <label class="block text-xs font-semibold text-slate-400 uppercase tracking-wider mb-2">Item Name</label>
          <input type="text" id="shop_name" placeholder="VIP Role" required class="w-full bg-[#0B0E14] border border-[#1E2538] rounded-xl px-4 py-2.5 text-white focus:outline-none focus:border-blurple text-sm">
        </div>
        <div>
          <label class="block text-xs font-semibold text-slate-400 uppercase tracking-wider mb-2">Price (Coins)</label>
          <input type="number" id="shop_price" min="1" placeholder="1000" required class="w-full bg-[#0B0E14] border border-[#1E2538] rounded-xl px-4 py-2.5 text-white focus:outline-none focus:border-blurple text-sm">
        </div>
        <div>
          <label class="block text-xs font-semibold text-slate-400 uppercase tracking-wider mb-2">Award Role (Optional)</label>
          <select id="shop_role" class="w-full bg-[#0B0E14] border border-[#1E2538] rounded-xl px-4 py-2.5 text-white focus:outline-none focus:border-blurple text-sm">
            <option value="">No role</option>
            <% roles.forEach(r => { %>
              <option value="<%= r.id %>">@<%= r.name %></option>
            <% }); %>
          </select>
        </div>
        <div class="flex items-end">
          <button type="submit" class="w-full bg-emerald-600 hover:bg-emerald-500 text-white text-sm font-semibold py-2.5 rounded-xl transition flex items-center justify-center gap-2">
            <i data-lucide="plus" class="w-4 h-4"></i>
            <span>Add Shop Item</span>
          </button>
        </div>
      </form>

      <!-- Shop Items Table -->
      <div class="overflow-x-auto">
        <table class="w-full text-left text-sm">
          <thead>
            <tr class="text-xs text-slate-400 border-b border-[#1E2538]">
              <th class="py-2.5 px-3">Item</th>
              <th class="py-2.5 px-3">Price</th>
              <th class="py-2.5 px-3">Role Awarded</th>
              <th class="py-2.5 px-3 text-right">Action</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-[#1E2538]">
            <% if (shopItems.length === 0) { %>
              <tr>
                <td colspan="4" class="py-4 text-center text-slate-500 text-xs">No shop items in server store.</td>
              </tr>
            <% } else { %>
              <% shopItems.forEach(item => { %>
                <% const r = roles.find(role => role.id === item.roleId); %>
                <tr class="hover:bg-[#181F2E]/50">
                  <td class="py-3 px-3 font-bold text-white"><%= item.name %></td>
                  <td class="py-3 px-3 text-yellow-400 font-semibold">🪙 <%= item.price.toLocaleString() %></td>
                  <td class="py-3 px-3 text-blurple"><%= r ? `@${r.name}` : '*None*' %></td>
                  <td class="py-3 px-3 text-right">
                    <button onclick="deleteShopItem('<%= item.id %>')" class="text-slate-400 hover:text-red-400 p-1.5 rounded transition">
                      <i data-lucide="trash-2" class="w-4 h-4"></i>
                    </button>
                  </td>
                </tr>
              <% }); %>
            <% } %>
          </tbody>
        </table>
      </div>
    </div>
  </main>
</div>

<script>
  document.getElementById('add-level-role-form')?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const level = parseInt(document.getElementById('lr_level').value, 10);
    const roleId = document.getElementById('lr_role').value;

    try {
      const res = await fetch('/api/guilds/<%= guild.id %>/level-roles', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ level, roleId })
      });
      const data = await res.json();
      if (res.ok && data.success) {
        showToast('Level reward added!');
        setTimeout(() => location.reload(), 600);
      } else {
        showToast(data.error || 'Failed', 'error');
      }
    } catch (err) {
      showToast('Network error', 'error');
    }
  });

  async function deleteLevelRole(level) {
    if (!confirm(`Delete reward for Level ${level}?`)) return;
    try {
      const res = await fetch(`/api/guilds/<%= guild.id %>/level-roles/${level}`, { method: 'DELETE' });
      const data = await res.json();
      if (res.ok && data.success) {
        showToast('Level reward removed.');
        setTimeout(() => location.reload(), 600);
      }
    } catch (err) {
      showToast('Network error', 'error');
    }
  }

  document.getElementById('add-shop-item-form')?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const name = document.getElementById('shop_name').value.trim();
    const price = parseInt(document.getElementById('shop_price').value, 10);
    const roleId = document.getElementById('shop_role').value;

    try {
      const res = await fetch('/api/guilds/<%= guild.id %>/shop-items', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ name, price, roleId })
      });
      const data = await res.json();
      if (res.ok && data.success) {
        showToast('Shop item added!');
        setTimeout(() => location.reload(), 600);
      } else {
        showToast(data.error || 'Failed', 'error');
      }
    } catch (err) {
      showToast('Network error', 'error');
    }
  });

  async function deleteShopItem(id) {
    if (!confirm('Delete this item from server shop?')) return;
    try {
      const res = await fetch(`/api/guilds/<%= guild.id %>/shop-items/${id}`, { method: 'DELETE' });
      const data = await res.json();
      if (res.ok && data.success) {
        showToast('Shop item deleted.');
        setTimeout(() => location.reload(), 600);
      }
    } catch (err) {
      showToast('Network error', 'error');
    }
  }
</script>

<%- include('partials/footer') %>
