<%- include('partials/head', { title: 'Legal & Verification Document Editor' }) %>
<%- include('partials/navbar') %>

<div class="flex-1 flex">
  <%- include('partials/sidebar', { tab: 'legal', guild: typeof guild !== 'undefined' ? guild : null }) %>

  <main class="flex-1 p-6 sm:p-10 space-y-8 overflow-y-auto max-w-6xl">
    <!-- Header Banner -->
    <div class="border-b border-[#1E2538] pb-6 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
      <div>
        <h1 class="text-2xl sm:text-3xl font-black text-white tracking-tight flex items-center gap-3">
          <i data-lucide="scale" class="w-8 h-8 text-blurple"></i>
          <span>Legal & Verification Document Editor</span>
        </h1>
        <p class="text-slate-400 text-sm mt-1">Manage public Privacy Policy and Terms of Service documents required for Discord Bot Verification.</p>
      </div>

      <div class="flex items-center gap-2">
        <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full text-xs font-semibold bg-emerald-500/10 text-emerald-400 border border-emerald-500/20">
          <i data-lucide="check" class="w-3.5 h-3.5"></i>
          <span>Public Routes Active</span>
        </span>
      </div>
    </div>

    <!-- 1. One-Click Copy URLs Box for Discord Developer Portal -->
    <div class="glass-card p-6 space-y-4 border-l-4 border-l-emerald-500">
      <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-2">
        <div>
          <h2 class="text-base font-bold text-white flex items-center gap-2">
            <i data-lucide="clipboard-copy" class="w-5 h-5 text-emerald-400"></i>
            <span>Discord Developer Portal URLs</span>
          </h2>
          <p class="text-xs text-slate-400 mt-0.5">Copy these exact public URLs and paste them directly into your Discord Application settings.</p>
        </div>
        <span class="text-[11px] font-mono uppercase bg-[#0B0E14] px-2.5 py-1 rounded-lg text-slate-400 border border-[#1E2538]">
          Public & Bypasses Login Gate
        </span>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-4 pt-2">
        <!-- Privacy URL Box -->
        <div class="p-3.5 rounded-xl bg-[#0B0E14] border border-[#1E2538] flex items-center justify-between gap-3">
          <div class="overflow-hidden">
            <div class="text-[10px] font-bold uppercase tracking-wider text-slate-500">Privacy Policy URL</div>
            <div id="privacy-url-text" class="text-xs font-mono text-emerald-400 truncate mt-0.5"><%= baseUrl %>/privacy</div>
          </div>
          <button type="button" class="copy-url-btn px-3 py-1.5 rounded-lg bg-[#1E2538] hover:bg-blurple text-slate-300 hover:text-white text-xs font-semibold transition flex items-center gap-1.5 flex-shrink-0" data-target="privacy-url-text">
            <i data-lucide="copy" class="w-3.5 h-3.5"></i>
            <span>Copy</span>
          </button>
        </div>

        <!-- Terms URL Box -->
        <div class="p-3.5 rounded-xl bg-[#0B0E14] border border-[#1E2538] flex items-center justify-between gap-3">
          <div class="overflow-hidden">
            <div class="text-[10px] font-bold uppercase tracking-wider text-slate-500">Terms of Service URL</div>
            <div id="terms-url-text" class="text-xs font-mono text-emerald-400 truncate mt-0.5"><%= baseUrl %>/terms</div>
          </div>
          <button type="button" class="copy-url-btn px-3 py-1.5 rounded-lg bg-[#1E2538] hover:bg-blurple text-slate-300 hover:text-white text-xs font-semibold transition flex items-center gap-1.5 flex-shrink-0" data-target="terms-url-text">
            <i data-lucide="copy" class="w-3.5 h-3.5"></i>
            <span>Copy</span>
          </button>
        </div>
      </div>
    </div>

    <!-- 2. Main Legal Editor Form -->
    <form id="legal-editor-form" class="space-y-6">
      <!-- Contact & Support Meta Card -->
      <div class="glass-card p-6 space-y-4">
        <h2 class="text-base font-bold text-white flex items-center gap-2">
          <i data-lucide="mail" class="w-5 h-5 text-blurple"></i>
          <span>Contact Information & Support Links</span>
        </h2>
        <p class="text-xs text-slate-400">These details are automatically injected into the legal templates and public footer.</p>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 pt-2">
          <div>
            <label class="block text-xs font-semibold text-slate-400 uppercase tracking-wider mb-2">Legal / Support Contact Email</label>
            <input 
              type="email" 
              id="contactEmail" 
              name="contactEmail" 
              value="<%= legalDocs.contactEmail || 'support@yourdomain.com' %>" 
              required
              class="w-full bg-[#0B0E14] border border-[#1E2538] rounded-xl px-4 py-2.5 text-white focus:outline-none focus:border-blurple text-xs"
            >
          </div>

          <div>
            <label class="block text-xs font-semibold text-slate-400 uppercase tracking-wider mb-2">Discord Support Server Invite URL</label>
            <input 
              type="url" 
              id="supportServerInvite" 
              name="supportServerInvite" 
              value="<%= legalDocs.supportServerInvite || 'https://discord.gg/yourserver' %>" 
              required
              class="w-full bg-[#0B0E14] border border-[#1E2538] rounded-xl px-4 py-2.5 text-white focus:outline-none focus:border-blurple text-xs"
            >
          </div>
        </div>
      </div>

      <!-- Document Tabs (Privacy Policy vs Terms of Service) -->
      <div class="glass-card p-6 space-y-6">
        <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 border-b border-[#1E2538] pb-4">
          <!-- Document Switcher -->
          <div class="flex items-center gap-2 bg-[#0B0E14] border border-[#1E2538] p-1 rounded-xl">
            <button type="button" id="tab-privacy-btn" class="doc-tab-btn active px-4 py-2 rounded-lg text-xs font-bold transition flex items-center gap-2 bg-blurple text-white shadow-md shadow-blurple/30" data-doc="privacy">
              <i data-lucide="shield" class="w-3.5 h-3.5"></i>
              <span>Privacy Policy</span>
            </button>
            <button type="button" id="tab-terms-btn" class="doc-tab-btn px-4 py-2 rounded-lg text-xs font-bold transition flex items-center gap-2 text-slate-400 hover:text-white" data-doc="terms">
              <i data-lucide="file-text" class="w-3.5 h-3.5"></i>
              <span>Terms of Service</span>
            </button>
          </div>

          <!-- Mode Toggle: Raw Markdown vs Live Preview -->
          <div class="flex items-center gap-2 bg-[#0B0E14] border border-[#1E2538] p-1 rounded-xl">
            <button type="button" id="mode-edit-btn" class="mode-btn px-3 py-1.5 rounded-lg text-xs font-semibold bg-[#1E2538] text-white flex items-center gap-1.5 transition">
              <i data-lucide="edit-3" class="w-3.5 h-3.5"></i>
              <span>Markdown Editor</span>
            </button>
            <button type="button" id="mode-preview-btn" class="mode-btn px-3 py-1.5 rounded-lg text-xs font-semibold text-slate-400 hover:text-white flex items-center gap-1.5 transition">
              <i data-lucide="eye" class="w-3.5 h-3.5"></i>
              <span>Live Preview</span>
            </button>
          </div>
        </div>

        <!-- Privacy Policy Editor Section -->
        <div id="section-privacy" class="doc-section space-y-3">
          <div class="flex items-center justify-between text-xs text-slate-400">
            <span>Markdown formatting supported. Pre-populated with verification-ready clauses.</span>
            <span class="font-mono text-[11px] text-slate-500">Characters: <span id="privacy-char-count">0</span></span>
          </div>

          <!-- Edit Mode -->
          <div id="privacy-editor-container" class="space-y-2">
            <textarea 
              id="privacyPolicyContent" 
              name="privacyPolicyContent" 
              rows="22" 
              class="w-full bg-[#0B0E14] border border-[#1E2538] rounded-xl p-4 text-slate-200 font-mono text-xs leading-relaxed focus:outline-none focus:border-blurple resize-y"
            ><%= legalDocs.privacyPolicy ? legalDocs.privacyPolicy.content : '' %></textarea>
          </div>

          <!-- Live Preview Mode -->
          <div id="privacy-preview-container" class="hidden p-6 rounded-xl bg-[#0B0E14] border border-[#1E2538] min-h-[400px] overflow-y-auto max-h-[600px] prose prose-invert max-w-none text-xs">
            <div id="privacy-preview-body" class="space-y-3 text-slate-300"></div>
          </div>
        </div>

        <!-- Terms of Service Editor Section -->
        <div id="section-terms" class="doc-section hidden space-y-3">
          <div class="flex items-center justify-between text-xs text-slate-400">
            <span>Markdown formatting supported. Pre-populated with verification-ready terms.</span>
            <span class="font-mono text-[11px] text-slate-500">Characters: <span id="terms-char-count">0</span></span>
          </div>

          <!-- Edit Mode -->
          <div id="terms-editor-container" class="space-y-2">
            <textarea 
              id="termsOfServiceContent" 
              name="termsOfServiceContent" 
              rows="22" 
              class="w-full bg-[#0B0E14] border border-[#1E2538] rounded-xl p-4 text-slate-200 font-mono text-xs leading-relaxed focus:outline-none focus:border-blurple resize-y"
            ><%= legalDocs.termsOfService ? legalDocs.termsOfService.content : '' %></textarea>
          </div>

          <!-- Live Preview Mode -->
          <div id="terms-preview-container" class="hidden p-6 rounded-xl bg-[#0B0E14] border border-[#1E2538] min-h-[400px] overflow-y-auto max-h-[600px] prose prose-invert max-w-none text-xs">
            <div id="terms-preview-body" class="space-y-3 text-slate-300"></div>
          </div>
        </div>

        <!-- Footer Actions Bar -->
        <div class="pt-4 border-t border-[#1E2538] flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
          <button type="button" id="reset-default-btn" class="px-4 py-2.5 rounded-xl bg-red-500/10 hover:bg-red-500/20 text-red-400 hover:text-red-300 border border-red-500/30 text-xs font-semibold flex items-center gap-2 transition">
            <i data-lucide="rotate-ccw" class="w-4 h-4"></i>
            <span>Reset to Verification-Ready Default</span>
          </button>

          <div class="flex items-center gap-3">
            <a href="/privacy" target="_blank" class="px-4 py-2.5 rounded-xl bg-[#1E2538] hover:bg-[#2A344D] text-slate-300 hover:text-white text-xs font-semibold flex items-center gap-1.5 transition">
              <i data-lucide="external-link" class="w-3.5 h-3.5"></i>
              <span>View Live Page</span>
            </a>
            
            <button type="submit" id="save-legal-btn" class="px-6 py-2.5 rounded-xl bg-blurple hover:bg-blurple-hover text-white text-xs font-bold shadow-lg shadow-blurple/30 flex items-center gap-2 transition">
              <i data-lucide="save" class="w-4 h-4"></i>
              <span>Save & Publish Changes</span>
            </button>
          </div>
        </div>
      </div>
    </form>
  </main>
</div>

<!-- Marked.js for fast in-browser preview -->
<script src="https://cdn.jsdelivr.net/npm/marked/marked.min.js"></script>

<script>
document.addEventListener('DOMContentLoaded', () => {
  // Elements
  const tabPrivacyBtn = document.getElementById('tab-privacy-btn');
  const tabTermsBtn = document.getElementById('tab-terms-btn');
  const sectionPrivacy = document.getElementById('section-privacy');
  const sectionTerms = document.getElementById('section-terms');

  const modeEditBtn = document.getElementById('mode-edit-btn');
  const modePreviewBtn = document.getElementById('mode-preview-btn');

  const privacyTextarea = document.getElementById('privacyPolicyContent');
  const termsTextarea = document.getElementById('termsOfServiceContent');
  const privacyEditorContainer = document.getElementById('privacy-editor-container');
  const privacyPreviewContainer = document.getElementById('privacy-preview-container');
  const privacyPreviewBody = document.getElementById('privacy-preview-body');

  const termsEditorContainer = document.getElementById('terms-editor-container');
  const termsPreviewContainer = document.getElementById('terms-preview-container');
  const termsPreviewBody = document.getElementById('terms-preview-body');

  const privacyCharCount = document.getElementById('privacy-char-count');
  const termsCharCount = document.getElementById('terms-char-count');

  let activeDoc = 'privacy';
  let activeMode = 'edit'; // 'edit' or 'preview'

  // Character counters
  function updateCounts() {
    if (privacyCharCount) privacyCharCount.textContent = (privacyTextarea.value || '').length.toLocaleString();
    if (termsCharCount) termsCharCount.textContent = (termsTextarea.value || '').length.toLocaleString();
  }
  privacyTextarea.addEventListener('input', updateCounts);
  termsTextarea.addEventListener('input', updateCounts);
  updateCounts();

  // Document switcher tabs
  tabPrivacyBtn.addEventListener('click', () => {
    activeDoc = 'privacy';
    tabPrivacyBtn.className = 'doc-tab-btn active px-4 py-2 rounded-lg text-xs font-bold transition flex items-center gap-2 bg-blurple text-white shadow-md shadow-blurple/30';
    tabTermsBtn.className = 'doc-tab-btn px-4 py-2 rounded-lg text-xs font-bold transition flex items-center gap-2 text-slate-400 hover:text-white';
    sectionPrivacy.classList.remove('hidden');
    sectionTerms.classList.add('hidden');
    if (activeMode === 'preview') renderActivePreview();
  });

  tabTermsBtn.addEventListener('click', () => {
    activeDoc = 'terms';
    tabTermsBtn.className = 'doc-tab-btn active px-4 py-2 rounded-lg text-xs font-bold transition flex items-center gap-2 bg-blurple text-white shadow-md shadow-blurple/30';
    tabPrivacyBtn.className = 'doc-tab-btn px-4 py-2 rounded-lg text-xs font-bold transition flex items-center gap-2 text-slate-400 hover:text-white';
    sectionTerms.classList.remove('hidden');
    sectionPrivacy.classList.add('hidden');
    if (activeMode === 'preview') renderActivePreview();
  });

  // Mode switcher (Edit vs Preview)
  function renderActivePreview() {
    if (window.marked) {
      if (activeDoc === 'privacy') {
        privacyPreviewBody.innerHTML = marked.parse(privacyTextarea.value || '');
      } else {
        termsPreviewBody.innerHTML = marked.parse(termsTextarea.value || '');
      }
    }
  }

  modeEditBtn.addEventListener('click', () => {
    activeMode = 'edit';
    modeEditBtn.className = 'mode-btn px-3 py-1.5 rounded-lg text-xs font-semibold bg-[#1E2538] text-white flex items-center gap-1.5 transition';
    modePreviewBtn.className = 'mode-btn px-3 py-1.5 rounded-lg text-xs font-semibold text-slate-400 hover:text-white flex items-center gap-1.5 transition';

    privacyEditorContainer.classList.remove('hidden');
    privacyPreviewContainer.classList.add('hidden');
    termsEditorContainer.classList.remove('hidden');
    termsPreviewContainer.classList.add('hidden');
  });

  modePreviewBtn.addEventListener('click', () => {
    activeMode = 'preview';
    modePreviewBtn.className = 'mode-btn px-3 py-1.5 rounded-lg text-xs font-semibold bg-[#1E2538] text-white flex items-center gap-1.5 transition';
    modeEditBtn.className = 'mode-btn px-3 py-1.5 rounded-lg text-xs font-semibold text-slate-400 hover:text-white flex items-center gap-1.5 transition';

    privacyEditorContainer.classList.add('hidden');
    privacyPreviewContainer.classList.remove('hidden');
    termsEditorContainer.classList.add('hidden');
    termsPreviewContainer.classList.remove('hidden');

    renderActivePreview();
  });

  // One-Click Copy URL buttons
  document.querySelectorAll('.copy-url-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      const targetId = btn.getAttribute('data-target');
      const textToCopy = document.getElementById(targetId)?.textContent;
      if (textToCopy) {
        navigator.clipboard.writeText(textToCopy).then(() => {
          showToast('URL copied to clipboard!', 'success');
          const orig = btn.innerHTML;
          btn.innerHTML = '<i data-lucide="check" class="w-3.5 h-3.5 text-emerald-400"></i> Copied!';
          if (window.lucide) window.lucide.createIcons();
          setTimeout(() => {
            btn.innerHTML = orig;
            if (window.lucide) window.lucide.createIcons();
          }, 2000);
        }).catch(() => {
          showToast('Failed to copy URL', 'error');
        });
      }
    });
  });

  // Reset to verification-ready defaults
  const resetBtn = document.getElementById('reset-default-btn');
  resetBtn.addEventListener('click', async () => {
    if (!confirm('Are you sure you want to reset both documents to the verification-ready default templates? Any custom edits will be overwritten.')) {
      return;
    }

    const contactEmail = document.getElementById('contactEmail').value;
    const supportServerInvite = document.getElementById('supportServerInvite').value;

    try {
      const res = await fetch('/api/bot/legal/reset', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ contactEmail, supportServerInvite })
      });
      const data = await res.json();
      if (data.success && data.documents) {
        privacyTextarea.value = data.documents.privacyPolicy?.content || '';
        termsTextarea.value = data.documents.termsOfService?.content || '';
        updateCounts();
        if (activeMode === 'preview') renderActivePreview();
        showToast('Reset to verification-ready defaults!', 'success');
      } else {
        showToast(data.error || 'Failed to reset documents', 'error');
      }
    } catch (err) {
      showToast('Error resetting documents: ' + err.message, 'error');
    }
  });

  // Save & Publish Form
  const form = document.getElementById('legal-editor-form');
  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    const saveBtn = document.getElementById('save-legal-btn');
    const origHtml = saveBtn.innerHTML;
    saveBtn.disabled = true;
    saveBtn.innerHTML = '<span class="inline-block animate-spin mr-2">⟳</span> Saving...';

    const payload = {
      contactEmail: document.getElementById('contactEmail').value,
      supportServerInvite: document.getElementById('supportServerInvite').value,
      privacyPolicy: privacyTextarea.value,
      termsOfService: termsTextarea.value
    };

    try {
      const res = await fetch('/api/bot/legal', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload)
      });
      const data = await res.json();
      if (data.success) {
        showToast(data.message || 'Legal documents saved & published!', 'success');
      } else {
        showToast(data.error || 'Failed to save legal documents', 'error');
      }
    } catch (err) {
      showToast('Error saving: ' + err.message, 'error');
    } finally {
      saveBtn.disabled = false;
      saveBtn.innerHTML = origHtml;
      if (window.lucide) window.lucide.createIcons();
    }
  });
});
</script>

<%- include('partials/footer') %>
