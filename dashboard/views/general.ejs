<%- include('partials/head', { title: `${guild.name} • General Settings` }) %>
<%- include('partials/navbar') %>

<div class="flex-1 flex">
  <%- include('partials/sidebar', { tab: 'general', guild }) %>

  <main class="flex-1 p-6 sm:p-10 space-y-8 overflow-y-auto max-w-5xl">
    <div class="border-b border-[#1E2538] pb-6">
      <h1 class="text-2xl sm:text-3xl font-black text-white tracking-tight">General & Module Settings</h1>
      <p class="text-slate-400 text-sm mt-1">Configure global server preferences and toggle bot systems ON or OFF.</p>
    </div>

    <form action="/api/guilds/<%= guild.id %>/general" method="POST" class="ajax-save-form space-y-8">
      <!-- General Preferences Card -->
      <div class="glass-card p-6 space-y-6">
        <h2 class="text-lg font-bold text-white flex items-center gap-2">
          <i data-lucide="settings" class="w-5 h-5 text-blurple"></i>
          <span>Global Preferences</span>
        </h2>

        <div class="grid grid-cols-1 sm:grid-cols-3 gap-6">
          <div>
            <label class="block text-xs font-semibold text-slate-400 uppercase tracking-wider mb-2">Bot Prefix</label>
            <input type="text" name="prefix" value="<%= settings.prefix || '!' %>" maxlength="5" class="w-full bg-[#0B0E14] border border-[#1E2538] rounded-xl px-4 py-2.5 text-white focus:outline-none focus:border-blurple text-sm">
          </div>

          <div>
            <label class="block text-xs font-semibold text-slate-400 uppercase tracking-wider mb-2">Language</label>
            <select name="language" class="w-full bg-[#0B0E14] border border-[#1E2538] rounded-xl px-4 py-2.5 text-white focus:outline-none focus:border-blurple text-sm">
              <option value="en" <%= settings.language === 'en' ? 'selected' : '' %>>English (US)</option>
              <option value="es" <%= settings.language === 'es' ? 'selected' : '' %>>Español</option>
              <option value="de" <%= settings.language === 'de' ? 'selected' : '' %>>Deutsch</option>
              <option value="fr" <%= settings.language === 'fr' ? 'selected' : '' %>>Français</option>
            </select>
          </div>

          <div>
            <label class="block text-xs font-semibold text-slate-400 uppercase tracking-wider mb-2">Embed Accent Color</label>
            <div class="flex items-center gap-3">
              <input type="color" name="embedColor" value="<%= settings.embedColor || '#5865F2' %>" class="w-10 h-10 rounded-xl bg-transparent border-0 cursor-pointer">
              <span class="text-xs font-mono text-slate-400"><%= settings.embedColor || '#5865F2' %></span>
            </div>
          </div>
        </div>
      </div>

      <!-- Module Toggles Card -->
      <div class="glass-card p-6 space-y-6">
        <div>
          <h2 class="text-lg font-bold text-white flex items-center gap-2">
            <i data-lucide="toggle-left" class="w-5 h-5 text-blurple"></i>
            <span>Module Toggles</span>
          </h2>
          <p class="text-xs text-slate-400 mt-1">Enable or disable entire functional modules in real-time without restarting the bot.</p>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <% 
            const moduleList = [
              { key: 'moderation', label: 'Moderation & Sticky Roles', desc: 'Ban, kick, timeout, warn, and persistent roles', icon: 'shield' },
              { key: 'automod', label: 'Auto-Moderation Engine', desc: 'Anti-invites, links, spam, and mass mentions', icon: 'shield-alert' },
              { key: 'logging', label: 'Audit & Server Logging', desc: 'Edits, deletes, joins, leaves, and voice activity', icon: 'file-text' },
              { key: 'reactionRoles', label: 'Reaction & Button Roles', desc: 'Interactive button & dropdown role assigners', icon: 'mouse-pointer-click' },
              { key: 'tickets', label: 'Support Tickets System', desc: 'Private channels with HTML transcript export', icon: 'ticket' },
              { key: 'leveling', label: 'Leveling & Rank Cards', desc: 'Text & voice XP tracking and rank cards', icon: 'award' },
              { key: 'economy', label: 'Economy, Shop & Minigames', desc: 'Daily streak rewards, custom shop & casino games', icon: 'coins' },
              { key: 'starboard', label: 'Starboard System', desc: 'Auto-pin popular messages reaching star reaction goals', icon: 'star' },
              { key: 'suggestions', label: 'Suggestions Engine', desc: 'Community ideas with upvote/downvote buttons', icon: 'lightbulb' },
              { key: 'giveaways', label: 'Giveaways System', desc: 'Auto-countdown prize giveaways with join buttons', icon: 'gift' },
              { key: 'tempVoice', label: 'Join-to-Create Voice Channels', desc: 'Auto-provision personal voice rooms with controls', icon: 'mic' },
              { key: 'counting', label: 'Counting Channel Game', desc: 'Sequential number enforcement & anti-cheat', icon: 'hash' },
              { key: 'birthdays', label: 'Birthday Announcements', desc: 'Celebrate member birthdays automatically', icon: 'cake' },
              { key: 'aiChat', label: 'Google Gemini AI Chat', desc: 'Conversational AI /ask powered by @google/genai', icon: 'bot' }
            ];
          %>

          <% moduleList.forEach(mod => { %>
            <% const isChecked = settings.modules && settings.modules[mod.key] !== false; %>
            <div class="flex items-center justify-between p-4 rounded-xl bg-[#0B0E14] border border-[#1E2538]">
              <div class="flex items-center gap-3">
                <div class="w-8 h-8 rounded-lg bg-blurple/10 text-blurple flex items-center justify-center flex-shrink-0">
                  <i data-lucide="<%= mod.icon %>" class="w-4 h-4"></i>
                </div>
                <div>
                  <div class="text-sm font-semibold text-white"><%= mod.label %></div>
                  <div class="text-xs text-slate-400"><%= mod.desc %></div>
                </div>
              </div>

              <!-- Animated Toggle -->
              <label class="relative inline-flex items-center cursor-pointer flex-shrink-0 ml-3">
                <input type="checkbox" name="modules[<%= mod.key %>]" class="sr-only peer" <%= isChecked ? 'checked' : '' %>>
                <div class="w-11 h-6 bg-slate-700 peer-focus:outline-none rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-slate-300 after:border after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:bg-blurple"></div>
              </label>
            </div>
          <% }); %>
        </div>
      </div>

      <!-- Sticky Save Bar -->
      <div class="glass-card p-4 flex items-center justify-between sticky bottom-6 shadow-2xl z-20">
        <span class="text-xs text-slate-400 flex items-center gap-1.5">
          <i data-lucide="info" class="w-4 h-4 text-blurple"></i>
          Changes take effect immediately on Discord.
        </span>
        <button type="submit" class="bg-blurple hover:bg-blurple-hover text-white text-sm font-bold px-6 py-2.5 rounded-xl transition flex items-center gap-2 shadow-lg shadow-blurple/25">
          <i data-lucide="save" class="w-4 h-4"></i>
          <span>Save Changes</span>
        </button>
      </div>
    </form>
  </main>
</div>

<%- include('partials/footer') %>
