<%- include('partials/head', { title: 'Select Server' }) %>
<%- include('partials/navbar') %>

<main class="flex-1 max-w-7xl w-full mx-auto p-6 sm:p-10 space-y-8">
  <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 border-b border-[#1E2538] pb-6">
    <div>
      <h1 class="text-2xl sm:text-3xl font-black text-white tracking-tight">Select a Server</h1>
      <p class="text-slate-400 text-sm mt-1">Master Console: Showing all active Discord servers connected to your bot worker.</p>
    </div>
    <div class="flex items-center gap-3">
      <% if (!user || !user.avatar) { %>
        <a href="/auth/discord" class="text-xs font-semibold text-slate-300 hover:text-white bg-[#131823] hover:bg-[#1E2538] border border-[#1E2538] px-3.5 py-2 rounded-xl transition flex items-center gap-2">
          <i data-lucide="link" class="w-3.5 h-3.5 text-blurple"></i>
          <span>Link Discord Account</span>
        </a>
      <% } %>
      <div class="text-xs text-slate-400 bg-[#131823] border border-[#1E2538] px-3.5 py-2 rounded-xl flex items-center gap-2">
        <span class="w-2 h-2 rounded-full bg-emerald-400"></span>
        <span><%= guilds.length %> Connected Servers</span>
      </div>
    </div>
  </div>

  <% if (guilds.length === 0) { %>
    <div class="glass-card p-12 text-center max-w-lg mx-auto space-y-5">
      <div class="w-16 h-16 rounded-2xl bg-blurple/10 border border-blurple/20 text-blurple flex items-center justify-center mx-auto">
        <i data-lucide="bot" class="w-8 h-8"></i>
      </div>
      <div>
        <h3 class="text-lg font-bold text-white">No Connected Servers Found</h3>
        <p class="text-slate-400 text-sm mt-1">
          Your bot is not currently in any Discord servers. Click below to invite your bot using its Client ID.
        </p>
      </div>
      <% const botInvite = `https://discord.com/api/oauth2/authorize?client_id=${clientId}&permissions=8&scope=bot%20applications.commands`; %>
      <a href="<%= botInvite %>" target="_blank" class="inline-flex items-center gap-2 bg-blurple hover:bg-blurple-hover text-white text-sm font-semibold px-6 py-2.5 rounded-xl transition shadow-lg shadow-blurple/25">
        <i data-lucide="plus-circle" class="w-4 h-4"></i>
        <span>Invite Bot to a Server</span>
      </a>
    </div>
  <% } else { %>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6">
      <% guilds.forEach(g => { %>
        <% const iconUrl = g.icon ? `https://cdn.discordapp.com/icons/${g.id}/${g.icon}.png?size=128` : null; %>
        <div class="glass-card glass-card-hover p-5 flex flex-col justify-between">
          <div class="flex items-center gap-4">
            <% if (iconUrl) { %>
              <img src="<%= iconUrl %>" alt="<%= g.name %>" class="w-14 h-14 rounded-2xl ring-2 ring-[#1E2538] flex-shrink-0">
            <% } else { %>
              <div class="w-14 h-14 rounded-2xl bg-blurple/15 border border-blurple/30 text-blurple font-black text-lg flex items-center justify-center flex-shrink-0">
                <%= g.name.substring(0, 2).toUpperCase() %>
              </div>
            <% } %>

            <div class="overflow-hidden">
              <h3 class="font-bold text-white text-base truncate" title="<%= g.name %>"><%= g.name %></h3>
              <div class="flex items-center gap-1.5 mt-1">
                <% if (g.botInGuild) { %>
                  <span class="w-2 h-2 rounded-full bg-emerald-400"></span>
                  <span class="text-xs text-emerald-400 font-medium">Bot Active</span>
                <% } else { %>
                  <span class="w-2 h-2 rounded-full bg-slate-500"></span>
                  <span class="text-xs text-slate-400 font-medium">Not Invited</span>
                <% } %>
              </div>
            </div>
          </div>

          <div class="mt-6 pt-4 border-t border-[#1E2538]">
            <% if (g.botInGuild) { %>
              <a href="/dashboard/<%= g.id %>" class="w-full bg-blurple hover:bg-blurple-hover text-white text-sm font-semibold py-2.5 rounded-xl transition flex items-center justify-center gap-2 shadow-md shadow-blurple/20">
                <i data-lucide="sliders" class="w-4 h-4"></i>
                <span>Manage Server</span>
              </a>
            <% } else { %>
              <% const inviteLink = `https://discord.com/api/oauth2/authorize?client_id=${clientId}&guild_id=${g.id}&permissions=8&scope=bot%20applications.commands`; %>
              <a href="<%= inviteLink %>" target="_blank" class="w-full bg-[#1E2538] hover:bg-[#2A344D] text-slate-200 hover:text-white text-sm font-semibold py-2.5 rounded-xl transition flex items-center justify-center gap-2">
                <i data-lucide="user-plus" class="w-4 h-4 text-blurple"></i>
                <span>Invite Bot</span>
              </a>
            <% } %>
          </div>
        </div>
      <% }); %>
    </div>
  <% } %>
</main>

<%- include('partials/footer') %>
