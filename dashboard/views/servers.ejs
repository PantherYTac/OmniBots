<%- include('partials/head', { title: 'Select Server' }) %>
<%- include('partials/navbar') %>

<main class="flex-1 max-w-7xl w-full mx-auto p-6 sm:p-10">

  <!-- Page Header -->
  <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 border-b border-white/5 pb-5 mb-8">
    <div>
      <h1 class="text-2xl font-bold text-white">Select a Server</h1>
      <p class="text-sm text-slate-500 mt-1">Manage any Discord server your bots are connected to.</p>
    </div>

    <!-- Right Header Controls -->
    <div class="flex flex-wrap items-center gap-3">
      <!-- Discord Account Status / Link Button -->
      <% if (typeof isLinked !== 'undefined' && isLinked && typeof discordUser !== 'undefined' && discordUser) { %>
        <div class="flex items-center gap-2 bg-[#0D1117] border border-white/8 px-3 py-1.5 rounded-xl text-xs">
          <% if (discordUser.avatar) { %>
            <img src="https://cdn.discordapp.com/avatars/<%= discordUser.id %>/<%= discordUser.avatar %>.png?size=32" alt="<%= discordUser.username %>" class="w-5 h-5 rounded-full ring-1 ring-emerald-400">
          <% } else { %>
            <div class="w-5 h-5 rounded-full bg-blurple/20 text-blurple flex items-center justify-center font-bold text-[10px]">
              <%= (discordUser.username || 'D').substring(0, 1).toUpperCase() %>
            </div>
          <% } %>
          <span class="font-semibold text-white">@<%= discordUser.username %></span>
          <span class="w-1.5 h-1.5 rounded-full bg-emerald-400"></span>
          <button 
            type="button" 
            onclick="openOAuthModal()" 
            title="Discord OAuth Settings"
            class="text-slate-500 hover:text-white p-1 rounded transition"
          >
            <i data-lucide="settings" class="w-3.5 h-3.5"></i>
          </button>
        </div>
      <% } else if (typeof oauthConfig !== 'undefined' && oauthConfig && oauthConfig.isConfigured) { %>
        <div class="flex items-center gap-1.5">
          <a 
            href="/auth/discord" 
            class="text-xs font-semibold text-white bg-blurple hover:bg-blurple-hover px-3.5 py-2 rounded-xl transition flex items-center gap-2 shadow-md shadow-blurple/20"
          >
            <i data-lucide="link" class="w-3.5 h-3.5"></i>
            <span>Link Discord Account</span>
          </a>
          <button 
            type="button" 
            onclick="openOAuthModal()" 
            title="Configure Client ID & Secret"
            class="text-slate-400 hover:text-white bg-[#0D1117] hover:bg-white/5 border border-white/8 p-2 rounded-xl transition"
          >
            <i data-lucide="settings" class="w-3.5 h-3.5"></i>
          </button>
        </div>
      <% } else { %>
        <button 
          type="button" 
          onclick="openOAuthModal()" 
          class="text-xs font-semibold text-slate-300 hover:text-white bg-[#0D1117] hover:bg-white/5 border border-white/8 px-3.5 py-2 rounded-xl transition flex items-center gap-2"
        >
          <i data-lucide="link" class="w-3.5 h-3.5 text-blurple"></i>
          <span>Link Discord Account</span>
          <span class="px-1.5 py-0.5 rounded text-[10px] bg-blurple/15 text-blurple font-bold">Setup</span>
        </button>
      <% } %>

      <span class="text-xs bg-emerald-500/10 text-emerald-400 border border-emerald-500/20 px-3 py-1.5 rounded-xl font-semibold flex items-center gap-1.5">
        <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 inline-block"></span>
        <%= guilds.length %> Connected
      </span>
    </div>
  </div>

  <!-- Empty State -->
  <% if (guilds.length === 0) { %>
    <div class="bg-[#0D1117] border border-white/5 rounded-2xl p-12 text-center max-w-lg mx-auto space-y-5">
      <div class="w-16 h-16 rounded-2xl bg-blurple/10 border border-blurple/20 text-blurple flex items-center justify-center mx-auto">
        <i data-lucide="bot" class="w-8 h-8"></i>
      </div>
      <div>
        <h3 class="text-base font-semibold text-white">No Connected Servers</h3>
        <p class="text-slate-500 text-sm mt-1.5">
          Your bot isn't in any Discord servers yet. Invite it to get started.
        </p>
      </div>
      <% const botInvite = clientId ? `https://discord.com/api/oauth2/authorize?client_id=${clientId}&permissions=8&scope=bot%20applications.commands` : '/dashboard/bots'; %>
      <a href="<%= botInvite %>" target="<%= clientId ? '_blank' : '_self' %>" class="inline-flex items-center gap-2 bg-blurple hover:bg-blurple-hover text-white text-sm font-semibold px-6 py-2.5 rounded-xl transition shadow-lg shadow-blurple/25">
        <i data-lucide="plus-circle" class="w-4 h-4"></i>
        <span><%= clientId ? 'Invite Bot to a Server' : 'Add Bot in Multi-Bot Hub' %></span>
      </a>
    </div>

  <!-- Server Grid -->
  <% } else { %>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-5">
      <% guilds.forEach(g => { %>
        <% const iconUrl = g.icon ? `https://cdn.discordapp.com/icons/${g.id}/${g.icon}.png?size=128` : null; %>

        <div class="bg-[#0D1117] border border-white/5 rounded-2xl p-5 flex flex-col justify-between hover:border-white/10 hover:bg-[#111827] transition-all duration-200">

          <!-- Server Info -->
          <div class="flex items-center gap-3">
            <% if (iconUrl) { %>
              <img src="<%= iconUrl %>" alt="<%= g.name %>" class="w-12 h-12 rounded-xl ring-1 ring-white/10 flex-shrink-0">
            <% } else { %>
              <div class="w-12 h-12 rounded-xl bg-blurple/15 border border-blurple/30 text-blurple font-black text-sm flex items-center justify-center flex-shrink-0 ring-1 ring-white/10">
                <%= g.name.substring(0, 2).toUpperCase() %>
              </div>
            <% } %>

            <div class="overflow-hidden min-w-0">
              <h3 class="text-sm font-semibold text-white truncate" title="<%= g.name %>"><%= g.name %></h3>
              <div class="mt-1">
                <% if (g.botInGuild) { %>
                  <span class="text-[11px] bg-emerald-500/10 text-emerald-400 px-2 py-0.5 rounded-full border border-emerald-500/20 font-medium">Bot Active</span>
                <% } else { %>
                  <span class="text-[11px] bg-slate-500/10 text-slate-500 px-2 py-0.5 rounded-full border border-slate-500/20 font-medium">Not Invited</span>
                <% } %>
              </div>
              <% if (g.approximate_member_count) { %>
                <p class="text-[11px] text-slate-600 mt-1"><%= g.approximate_member_count.toLocaleString() %> members</p>
              <% } %>
            </div>
          </div>

          <!-- Action Button -->
          <div class="mt-5 pt-4 border-t border-white/5">
            <% if (g.botInGuild) { %>
              <a href="/dashboard/<%= g.id %>" class="w-full bg-blurple hover:bg-blurple-hover text-white text-sm font-semibold py-2.5 rounded-xl transition flex items-center justify-center gap-2 shadow-md shadow-blurple/20">
                <i data-lucide="sliders" class="w-4 h-4"></i>
                <span>Manage Server</span>
              </a>
            <% } else { %>
              <% const inviteLink = clientId ? `https://discord.com/api/oauth2/authorize?client_id=${clientId}&guild_id=${g.id}&permissions=8&scope=bot%20applications.commands` : '#'; %>
              <a href="<%= inviteLink %>" <%= clientId ? 'target="_blank"' : 'onclick="openOAuthModal(); return false;"' %> class="w-full bg-white/5 hover:bg-white/10 text-slate-200 text-sm font-semibold py-2.5 rounded-xl transition flex items-center justify-center gap-2">
                <i data-lucide="user-plus" class="w-4 h-4 text-blurple"></i>
                <span>Invite Bot</span>
              </a>
            <% } %>
          </div>
        </div>
      <% }); %>
    </div>
  <% } %>
</main>

<%- include('partials/oauth-modal') %>
<%- include('partials/footer') %>
