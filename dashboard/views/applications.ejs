<%- include('partials/head', { title: `${guild.name} • Staff Applications` }) %>
<%- include('partials/navbar') %>

<div class="flex-1 flex">
  <%- include('partials/sidebar', { tab: 'applications', guild }) %>

  <main class="flex-1 p-6 sm:p-10 space-y-8 overflow-y-auto max-w-6xl">
    <!-- Header Banner -->
    <div class="border-b border-[#1E2538] pb-6 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
      <div>
        <h1 class="text-2xl sm:text-3xl font-black text-white tracking-tight flex items-center gap-3">
          <i data-lucide="clipboard-check" class="w-8 h-8 text-emerald-400"></i>
          <span>Staff & Community Applications</span>
        </h1>
        <p class="text-slate-400 text-sm mt-1">Multi-position recruitment forms, Discord Modal & interactive DM interviews, and staff review queue.</p>
      </div>

      <div class="flex items-center gap-3">
        <button type="button" id="open-new-form-btn" class="px-4 py-2 rounded-xl bg-blurple hover:bg-blurple-hover text-white text-xs font-bold shadow-md shadow-blurple/20 flex items-center gap-2 transition">
          <i data-lucide="plus-circle" class="w-4 h-4"></i>
          <span>New Position</span>
        </button>
      </div>
    </div>

    <!-- 1. Application Positions Studio -->
    <div class="glass-card p-6 space-y-6">
      <div class="flex items-center justify-between border-b border-[#1E2538] pb-4">
        <div>
          <h2 class="text-lg font-bold text-white flex items-center gap-2">
            <i data-lucide="briefcase" class="w-5 h-5 text-blurple"></i>
            <span>Configured Positions & Forms</span>
          </h2>
          <p class="text-xs text-slate-400">Manage recruitment positions, toggles, questions, and automated role assignments.</p>
        </div>
        <span class="text-xs text-slate-500 font-mono font-semibold"><%= forms.length %> Position(s)</span>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <% forms.forEach(form => { %>
          <div class="p-5 rounded-2xl bg-[#0B0E14] border border-[#1E2538] hover:border-[#2B354C] transition flex flex-col justify-between space-y-4">
            <div class="space-y-3">
              <div class="flex items-start justify-between gap-3">
                <div>
                  <h3 class="text-white font-bold text-sm flex items-center gap-2">
                    <span><%= form.name %></span>
                    <% if (form.isOpen) { %>
                      <span class="px-2 py-0.5 rounded-full text-[10px] font-bold bg-emerald-500/20 text-emerald-400 border border-emerald-500/30">OPEN</span>
                    <% } else { %>
                      <span class="px-2 py-0.5 rounded-full text-[10px] font-bold bg-red-500/20 text-red-400 border border-red-500/30">CLOSED</span>
                    <% } %>
                  </h3>
                  <span class="text-[11px] font-mono text-slate-500"><%= form.id %></span>
                </div>

                <!-- Toggle Open/Closed -->
                <button type="button" class="toggle-form-btn px-3 py-1 rounded-xl text-xs font-bold border transition <%= form.isOpen ? 'bg-emerald-500/10 text-emerald-400 border-emerald-500/30 hover:bg-emerald-500/20' : 'bg-red-500/10 text-red-400 border-red-500/30 hover:bg-red-500/20' %>" data-id="<%= form.id %>">
                  <%= form.isOpen ? 'Accepting Apps' : 'Paused' %>
                </button>
              </div>

              <p class="text-xs text-slate-400 line-clamp-2"><%= form.description || 'No description provided.' %></p>

              <div class="text-[11px] space-y-1 text-slate-500 border-t border-[#1E2538] pt-2">
                <div>Questions: <span class="font-bold text-cyan-accent"><%= (form.questions || []).length %> questions</span> (<%= (form.questions || []).some(q => q.type === 'choice') || (form.questions || []).length > 5 ? 'Interactive DM Interview' : 'Discord Modal' %>)</div>
                <div>Review Channel: <span class="font-mono text-slate-300"><%= form.reviewChannelId ? `<#${form.reviewChannelId}>` : 'None' %></span></div>
                <div>Requirements: <span class="font-bold text-white"><%= form.minAccountAgeDays || 0 %>d account • <%= form.minServerDays || 0 %>d in server</span></div>
                <% if (form.panelMessageId) { %>
                  <div class="text-emerald-400 font-medium">Published live in <#<%= form.panelChannelId %>></div>
                <% } %>
              </div>
            </div>

            <div class="flex items-center justify-between pt-3 border-t border-[#1E2538] gap-2">
              <button type="button" class="publish-app-btn px-3 py-1.5 rounded-lg bg-blurple hover:bg-blurple-hover text-white text-xs font-bold transition flex items-center gap-1.5" data-id="<%= form.id %>">
                <i data-lucide="send" class="w-3.5 h-3.5"></i>
                <span>Publish Panel</span>
              </button>

              <div class="flex items-center gap-2">
                <button type="button" class="edit-form-btn px-3 py-1.5 rounded-lg bg-[#131823] hover:bg-[#1E2538] text-xs font-semibold text-slate-300 hover:text-white transition flex items-center gap-1.5" data-form='<%- JSON.stringify(form).replace(/\x27/g, "&apos;") %>'>
                  <i data-lucide="edit-3" class="w-3.5 h-3.5"></i>
                  <span>Edit</span>
                </button>
                <button type="button" class="del-form-btn p-1.5 rounded-lg bg-red-500/10 hover:bg-red-500/20 text-red-400 transition" data-id="<%= form.id %>">
                  <i data-lucide="trash-2" class="w-4 h-4"></i>
                </button>
              </div>
            </div>
          </div>
        <% }); %>
      </div>
    </div>

    <!-- 2. Staff Review Queue & Submissions -->
    <div class="glass-card p-6 space-y-4">
      <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 border-b border-[#1E2538] pb-4">
        <div>
          <h2 class="text-lg font-bold text-white flex items-center gap-2">
            <i data-lucide="inbox" class="w-5 h-5 text-cyan-accent"></i>
            <span>Staff Review Queue</span>
          </h2>
          <p class="text-xs text-slate-400">Review submitted answers, tally staff votes, and accept or reject candidates.</p>
        </div>

        <!-- Filter Pills -->
        <div class="flex items-center gap-1.5 bg-[#0B0E14] p-1 rounded-xl border border-[#1E2538] text-xs">
          <button type="button" class="status-filter-btn px-3 py-1 rounded-lg font-bold bg-blurple text-white" data-status="all">All (<%= submissions.length %>)</button>
          <button type="button" class="status-filter-btn px-3 py-1 rounded-lg font-bold text-slate-400 hover:text-white" data-status="pending">Pending (<%= submissions.filter(s => s.status === 'pending').length %>)</button>
          <button type="button" class="status-filter-btn px-3 py-1 rounded-lg font-bold text-slate-400 hover:text-white" data-status="accepted">Accepted (<%= submissions.filter(s => s.status === 'accepted').length %>)</button>
          <button type="button" class="status-filter-btn px-3 py-1 rounded-lg font-bold text-slate-400 hover:text-white" data-status="denied">Denied (<%= submissions.filter(s => s.status === 'denied').length %>)</button>
        </div>
      </div>

      <% if (submissions.length === 0) { %>
        <div class="text-center py-10 text-slate-500 text-sm">
          No candidate submissions yet. When members apply via Discord, their answers will appear here!
        </div>
      <% } else { %>
        <div class="overflow-x-auto">
          <table class="w-full text-left text-sm" id="subs-table">
            <thead>
              <tr class="text-xs text-slate-400 border-b border-[#1E2538]">
                <th class="py-3 px-4">Submission ID</th>
                <th class="py-3 px-4">Applicant</th>
                <th class="py-3 px-4">Position</th>
                <th class="py-3 px-4">Status</th>
                <th class="py-3 px-4">Staff Votes</th>
                <th class="py-3 px-4">Applied</th>
                <th class="py-3 px-4 text-right">Actions</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-[#1E2538]">
              <% submissions.forEach(sub => { %>
                <tr class="hover:bg-[#181F2E]/50 transition sub-row" data-status="<%= sub.status %>">
                  <td class="py-3 px-4 font-mono text-xs text-blurple font-bold"><%= sub.submissionId || sub.id %></td>
                  <td class="py-3 px-4">
                    <div class="flex items-center gap-2.5">
                      <% if (sub.applicantAvatar) { %>
                        <img src="<%= sub.applicantAvatar %>" alt="" class="w-6 h-6 rounded-full">
                      <% } %>
                      <div>
                        <div class="text-white font-medium text-xs"><%= sub.applicantTag %></div>
                        <div class="text-[10px] font-mono text-slate-500"><%= sub.applicantId %></div>
                      </div>
                    </div>
                  </td>
                  <td class="py-3 px-4 text-xs font-semibold text-slate-300">
                    <% const matchedForm = forms.find(f => f.id === sub.formId); %>
                    <%= matchedForm ? matchedForm.name : sub.formId %>
                  </td>
                  <td class="py-3 px-4">
                    <% if (sub.status === 'pending') { %>
                      <span class="text-xs font-semibold px-2 py-0.5 rounded-full bg-amber-500/10 text-amber-400 border border-amber-500/20">🟡 Pending</span>
                    <% } else if (sub.status === 'interviewing') { %>
                      <span class="text-xs font-semibold px-2 py-0.5 rounded-full bg-cyan-500/10 text-cyan-400 border border-cyan-500/20">🔵 Interviewing</span>
                    <% } else if (sub.status === 'accepted') { %>
                      <span class="text-xs font-semibold px-2 py-0.5 rounded-full bg-emerald-500/10 text-emerald-400 border border-emerald-500/20">🟢 Accepted</span>
                    <% } else { %>
                      <span class="text-xs font-semibold px-2 py-0.5 rounded-full bg-red-500/10 text-red-400 border border-red-500/20">🔴 Denied</span>
                    <% } %>
                  </td>
                  <td class="py-3 px-4 text-xs font-mono">
                    <span class="text-emerald-400 font-bold">👍 <%= (sub.upvotes || []).length %></span> • <span class="text-red-400 font-bold">👎 <%= (sub.downvotes || []).length %></span>
                  </td>
                  <td class="py-3 px-4 text-slate-500 text-xs">
                    <%= new Date(sub.createdAt).toLocaleDateString() %>
                  </td>
                  <td class="py-3 px-4 text-right">
                    <div class="flex items-center justify-end gap-2">
                      <button type="button" class="view-answers-btn px-2.5 py-1 rounded-lg bg-blurple/10 hover:bg-blurple text-blurple hover:text-white text-xs font-semibold transition" data-sub='<%- JSON.stringify(sub).replace(/\x27/g, "&apos;") %>'>
                        View Answers
                      </button>
                      <% if (sub.status === 'pending' || sub.status === 'interviewing') { %>
                        <button type="button" class="decision-btn px-2.5 py-1 rounded-lg bg-emerald-500/10 hover:bg-emerald-500/20 text-emerald-400 text-xs font-bold transition" data-id="<%= sub.submissionId || sub.id %>" data-action="accepted">
                          Accept
                        </button>
                        <button type="button" class="decision-btn px-2.5 py-1 rounded-lg bg-red-500/10 hover:bg-red-500/20 text-red-400 text-xs font-bold transition" data-id="<%= sub.submissionId || sub.id %>" data-action="denied">
                          Deny
                        </button>
                      <% } %>
                    </div>
                  </td>
                </tr>
              <% }); %>
            </tbody>
          </table>
        </div>
      <% } %>
    </div>
  </main>
</div>

<!-- MODAL: CREATE / EDIT APPLICATION POSITION -->
<div id="form-modal" class="fixed inset-0 bg-black/80 backdrop-blur-sm z-50 flex items-center justify-center p-4 hidden">
  <div class="glass-card w-full max-w-2xl max-h-[90vh] overflow-y-auto p-6 space-y-6">
    <div class="flex items-center justify-between border-b border-[#1E2538] pb-4">
      <h3 class="text-lg font-bold text-white flex items-center gap-2" id="form-modal-title">
        <i data-lucide="clipboard-edit" class="w-5 h-5 text-emerald-400"></i>
        <span>Configure Application Position</span>
      </h3>
      <button type="button" id="close-form-modal" class="text-slate-400 hover:text-white"><i data-lucide="x" class="w-5 h-5"></i></button>
    </div>

    <form id="position-form" class="space-y-4">
      <input type="hidden" id="form-id" name="id">

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <div>
          <label class="block text-xs font-semibold text-slate-400 uppercase tracking-wider mb-2">Position Title</label>
          <input type="text" id="form-name" name="name" class="w-full bg-[#0B0E14] border border-[#1E2538] rounded-xl px-4 py-2.5 text-white text-sm" placeholder="Staff Moderator" required>
        </div>
        <div>
          <label class="block text-xs font-semibold text-slate-400 uppercase tracking-wider mb-2">Staff Review Channel</label>
          <select id="form-review-chan" name="reviewChannelId" class="w-full bg-[#0B0E14] border border-[#1E2538] rounded-xl px-4 py-2.5 text-white text-sm">
            <option value="">Select Channel...</option>
            <% channels.forEach(ch => { %>
              <option value="<%= ch.id %>"># <%= ch.name %></option>
            <% }); %>
          </select>
        </div>
      </div>

      <div>
        <label class="block text-xs font-semibold text-slate-400 uppercase tracking-wider mb-2">Position Summary</label>
        <textarea id="form-desc" name="description" rows="2" class="w-full bg-[#0B0E14] border border-[#1E2538] rounded-xl px-4 py-2.5 text-white text-sm" placeholder="Help monitor server discussions and assist members"></textarea>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
        <div>
          <label class="block text-xs font-semibold text-slate-400 uppercase tracking-wider mb-2">Min Account Age (Days)</label>
          <input type="number" id="form-min-age" name="minAccountAgeDays" min="0" value="14" class="w-full bg-[#0B0E14] border border-[#1E2538] rounded-xl px-4 py-2.5 text-white text-sm">
        </div>
        <div>
          <label class="block text-xs font-semibold text-slate-400 uppercase tracking-wider mb-2">Min Server Days</label>
          <input type="number" id="form-min-server-days" name="minServerDays" min="0" value="3" class="w-full bg-[#0B0E14] border border-[#1E2538] rounded-xl px-4 py-2.5 text-white text-sm">
        </div>
        <div>
          <label class="block text-xs font-semibold text-slate-400 uppercase tracking-wider mb-2">Reapply Cooldown (Hours)</label>
          <input type="number" id="form-cooldown" name="reapplyCooldownHours" min="0" value="72" class="w-full bg-[#0B0E14] border border-[#1E2538] rounded-xl px-4 py-2.5 text-white text-sm">
        </div>
      </div>

      <!-- Automated Roles -->
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 border-t border-[#1E2538] pt-4">
        <div>
          <label class="block text-xs font-semibold text-slate-400 uppercase tracking-wider mb-2">Roles to Grant on Accept</label>
          <select id="form-accept-roles" class="w-full bg-[#0B0E14] border border-[#1E2538] rounded-xl px-4 py-2.5 text-white text-sm" multiple size="3">
            <% roles.forEach(r => { %>
              <option value="<%= r.id %>">@<%= r.name %></option>
            <% }); %>
          </select>
          <span class="text-[11px] text-slate-500">Hold Ctrl/Cmd to select multiple</span>
        </div>
        <div>
          <label class="block text-xs font-semibold text-slate-400 uppercase tracking-wider mb-2">Roles to Remove on Accept</label>
          <select id="form-remove-roles" class="w-full bg-[#0B0E14] border border-[#1E2538] rounded-xl px-4 py-2.5 text-white text-sm" multiple size="3">
            <% roles.forEach(r => { %>
              <option value="<%= r.id %>">@<%= r.name %></option>
            <% }); %>
          </select>
        </div>
      </div>

      <!-- Questions Builder -->
      <div class="border-t border-[#1E2538] pt-4 space-y-3">
        <div class="flex items-center justify-between">
          <label class="text-xs font-semibold text-white uppercase tracking-wider">Application Questions</label>
          <button type="button" id="add-app-q-btn" class="text-xs text-emerald-400 hover:underline font-bold flex items-center gap-1">
            <i data-lucide="plus" class="w-3.5 h-3.5"></i> Add Question
          </button>
        </div>
        <p class="text-[11px] text-slate-500">1–5 short/paragraph questions render via Discord Modal; 6+ questions or choice menus deliver step-by-step in DM.</p>
        <div id="app-questions-container" class="space-y-3"></div>
      </div>

      <div class="flex items-center justify-end gap-3 pt-4 border-t border-[#1E2538]">
        <button type="button" id="cancel-form-btn" class="px-4 py-2 rounded-xl bg-[#131823] text-white text-xs font-semibold">Cancel</button>
        <button type="submit" class="px-5 py-2.5 rounded-xl bg-blurple hover:bg-blurple-hover text-white text-xs font-bold shadow-md shadow-blurple/20">Save Position</button>
      </div>
    </form>
  </div>
</div>

<!-- MODAL: PUBLISH APPLICATION PANEL -->
<div id="publish-app-modal" class="fixed inset-0 bg-black/80 backdrop-blur-sm z-50 flex items-center justify-center p-4 hidden">
  <div class="glass-card w-full max-w-md p-6 space-y-5">
    <div class="flex items-center justify-between border-b border-[#1E2538] pb-4">
      <h3 class="text-lg font-bold text-white flex items-center gap-2">
        <i data-lucide="send" class="w-5 h-5 text-emerald-400"></i>
        <span>Publish Application Panel</span>
      </h3>
      <button type="button" id="close-publish-app-modal" class="text-slate-400 hover:text-white"><i data-lucide="x" class="w-5 h-5"></i></button>
    </div>

    <form id="publish-app-form" class="space-y-4">
      <input type="hidden" id="publish-app-form-id" name="formId">

      <div>
        <label class="block text-xs font-semibold text-slate-400 uppercase tracking-wider mb-2">Select Target Channel</label>
        <select id="publish-app-channel" name="channelId" class="w-full bg-[#0B0E14] border border-[#1E2538] rounded-xl px-4 py-2.5 text-white text-sm" required>
          <% channels.forEach(ch => { %>
            <option value="<%= ch.id %>"># <%= ch.name %></option>
          <% }); %>
        </select>
      </div>

      <div class="flex items-center justify-end gap-3 pt-3 border-t border-[#1E2538]">
        <button type="button" id="cancel-publish-app-btn" class="px-4 py-2 rounded-xl bg-[#131823] text-white text-xs font-semibold">Cancel</button>
        <button type="submit" id="confirm-publish-app-btn" class="px-5 py-2.5 rounded-xl bg-blurple hover:bg-blurple-hover text-white text-xs font-bold shadow-md shadow-blurple/20 flex items-center gap-1.5">
          <i data-lucide="send" class="w-3.5 h-3.5"></i>
          <span>Publish Now</span>
        </button>
      </div>
    </form>
  </div>
</div>

<!-- MODAL: VIEW ANSWERS -->
<div id="answers-modal" class="fixed inset-0 bg-black/80 backdrop-blur-sm z-50 flex items-center justify-center p-4 hidden">
  <div class="glass-card w-full max-w-xl max-h-[85vh] overflow-y-auto p-6 space-y-5">
    <div class="flex items-center justify-between border-b border-[#1E2538] pb-4">
      <h3 class="text-lg font-bold text-white flex items-center gap-2">
        <i data-lucide="file-text" class="w-5 h-5 text-blurple"></i>
        <span id="answers-modal-title">Application Answers</span>
      </h3>
      <button type="button" id="close-answers-modal" class="text-slate-400 hover:text-white"><i data-lucide="x" class="w-5 h-5"></i></button>
    </div>

    <div id="answers-content" class="space-y-4 text-sm"></div>

    <div class="flex justify-end pt-3 border-t border-[#1E2538]">
      <button type="button" id="dismiss-answers-btn" class="px-4 py-2 rounded-xl bg-[#131823] text-white text-xs font-semibold">Close</button>
    </div>
  </div>
</div>

<!-- MODAL: DECISION (ACCEPT/DENY) -->
<div id="decision-modal" class="fixed inset-0 bg-black/80 backdrop-blur-sm z-50 flex items-center justify-center p-4 hidden">
  <div class="glass-card w-full max-w-md p-6 space-y-4">
    <h3 class="text-lg font-bold text-white" id="decision-title">Staff Decision</h3>
    <textarea id="decision-note" rows="3" class="w-full bg-[#0B0E14] border border-[#1E2538] rounded-xl px-4 py-2.5 text-white text-sm" placeholder="Optional note or reason sent directly to applicant via DM..."></textarea>
    <div class="flex justify-end gap-3 pt-2">
      <button type="button" id="cancel-decision-btn" class="px-4 py-2 rounded-xl bg-[#131823] text-white text-xs font-semibold">Cancel</button>
      <button type="button" id="confirm-decision-btn" class="px-5 py-2.5 rounded-xl text-white text-xs font-bold shadow-md"></button>
    </div>
  </div>
</div>

<script>
document.addEventListener('DOMContentLoaded', () => {
  const guildId = '<%= guild.id %>';

  // Questions dynamic builder
  let appQuestions = [];
  function renderAppQuestions() {
    const container = document.getElementById('app-questions-container');
    container.innerHTML = '';
    appQuestions.forEach((q, idx) => {
      const div = document.createElement('div');
      div.className = 'p-3 rounded-xl bg-[#131823] border border-[#1E2538] space-y-2';
      div.innerHTML = `
        <div class="flex items-center justify-between">
          <span class="text-xs font-bold text-slate-300">Question ${idx + 1}</span>
          <button type="button" class="text-red-400 hover:text-red-300 text-xs font-semibold" onclick="removeAppQ(${idx})">Remove</button>
        </div>
        <input type="text" class="w-full bg-[#0B0E14] border border-[#1E2538] rounded-lg px-3 py-1.5 text-xs text-white" placeholder="Question prompt" value="${q.prompt || ''}" onchange="updateAppQPrompt(${idx}, this.value)">
        <div class="grid grid-cols-2 gap-2">
          <select class="bg-[#0B0E14] border border-[#1E2538] rounded-lg px-2 py-1 text-xs text-white" onchange="updateAppQType(${idx}, this.value)">
            <option value="paragraph" ${q.type === 'paragraph' ? 'selected' : ''}>Paragraph (Multi-line)</option>
            <option value="short" ${q.type === 'short' ? 'selected' : ''}>Short Text</option>
            <option value="choice" ${q.type === 'choice' ? 'selected' : ''}>Multiple Choice (DM Only)</option>
          </select>
          <input type="text" class="bg-[#0B0E14] border border-[#1E2538] rounded-lg px-2 py-1 text-xs text-white ${q.type === 'choice' ? '' : 'hidden'}" placeholder="Comma-separated options" value="${(q.options || []).join(', ')}" onchange="updateAppQOptions(${idx}, this.value)">
        </div>
      `;
      container.appendChild(div);
    });
  }

  window.removeAppQ = (idx) => { appQuestions.splice(idx, 1); renderAppQuestions(); };
  window.updateAppQPrompt = (idx, val) => { appQuestions[idx].prompt = val; };
  window.updateAppQType = (idx, val) => { appQuestions[idx].type = val; renderAppQuestions(); };
  window.updateAppQOptions = (idx, val) => { appQuestions[idx].options = val.split(',').map(s => s.trim()).filter(Boolean); };

  document.getElementById('add-app-q-btn').addEventListener('click', () => {
    appQuestions.push({ prompt: '', type: 'paragraph', options: [] });
    renderAppQuestions();
  });

  // Modal handlers
  const formModal = document.getElementById('form-modal');
  const openNewFormBtn = document.getElementById('open-new-form-btn');
  const closeFormModal = document.getElementById('close-form-modal');
  const cancelFormBtn = document.getElementById('cancel-form-btn');

  function showFormModal(form = null) {
    document.getElementById('form-id').value = form ? form.id : '';
    document.getElementById('form-name').value = form ? form.name : '';
    document.getElementById('form-desc').value = form ? (form.description || '') : '';
    document.getElementById('form-review-chan').value = form ? (form.reviewChannelId || '') : '';
    document.getElementById('form-min-age').value = form ? (form.minAccountAgeDays || 0) : 14;
    document.getElementById('form-min-server-days').value = form ? (form.minServerDays || 0) : 3;
    document.getElementById('form-cooldown').value = form ? (form.reapplyCooldownHours || 24) : 72;

    appQuestions = form && Array.isArray(form.questions) ? JSON.parse(JSON.stringify(form.questions)) : [];
    renderAppQuestions();

    formModal.classList.remove('hidden');
    if (window.lucide) window.lucide.createIcons();
  }

  if (openNewFormBtn) openNewFormBtn.addEventListener('click', () => showFormModal());
  if (closeFormModal) closeFormModal.addEventListener('click', () => formModal.classList.add('hidden'));
  if (cancelFormBtn) cancelFormBtn.addEventListener('click', () => formModal.classList.add('hidden'));

  document.querySelectorAll('.edit-form-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      try {
        const f = JSON.parse(btn.getAttribute('data-form'));
        showFormModal(f);
      } catch (err) {
        alert('Error: ' + err.message);
      }
    });
  });

  document.getElementById('position-form').addEventListener('submit', async (e) => {
    e.preventDefault();
    const acceptSelect = document.getElementById('form-accept-roles');
    const removeSelect = document.getElementById('form-remove-roles');

    const payload = {
      id: document.getElementById('form-id').value,
      name: document.getElementById('form-name').value,
      description: document.getElementById('form-desc').value,
      reviewChannelId: document.getElementById('form-review-chan').value,
      minAccountAgeDays: parseInt(document.getElementById('form-min-age').value, 10),
      minServerDays: parseInt(document.getElementById('form-min-server-days').value, 10),
      reapplyCooldownHours: parseInt(document.getElementById('form-cooldown').value, 10),
      acceptRoleIds: Array.from(acceptSelect.selectedOptions).map(o => o.value),
      removeRoleIds: Array.from(removeSelect.selectedOptions).map(o => o.value),
      questions: appQuestions.filter(q => q.prompt && q.prompt.trim())
    };

    try {
      const res = await fetch(`/api/guilds/${guildId}/applications/forms`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload)
      });
      const data = await res.json();
      if (data.success) window.location.reload();
      else alert(data.error || 'Failed to save form');
    } catch {
      alert('Network error saving form');
    }
  });

  // Toggle Form
  document.querySelectorAll('.toggle-form-btn').forEach(btn => {
    btn.addEventListener('click', async () => {
      const id = btn.getAttribute('data-id');
      try {
        const res = await fetch(`/api/guilds/${guildId}/applications/forms/${id}/toggle`, { method: 'POST' });
        const data = await res.json();
        if (data.success) window.location.reload();
        else alert(data.error || 'Failed to toggle status');
      } catch {
        alert('Network error');
      }
    });
  });

  // Delete Form
  document.querySelectorAll('.del-form-btn').forEach(btn => {
    btn.addEventListener('click', async () => {
      const id = btn.getAttribute('data-id');
      if (!confirm('Are you sure you want to delete this application position?')) return;
      try {
        const res = await fetch(`/api/guilds/${guildId}/applications/forms/${id}`, { method: 'DELETE' });
        const data = await res.json();
        if (data.success) window.location.reload();
        else alert(data.error || 'Failed to delete form');
      } catch {
        alert('Network error');
      }
    });
  });

  // Publish Form Modal
  const pubAppModal = document.getElementById('publish-app-modal');
  const pubAppFormId = document.getElementById('publish-app-form-id');
  const closePubAppModal = document.getElementById('close-publish-app-modal');
  const cancelPubAppBtn = document.getElementById('cancel-publish-app-btn');

  document.querySelectorAll('.publish-app-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      pubAppFormId.value = btn.getAttribute('data-id');
      pubAppModal.classList.remove('hidden');
    });
  });
  if (closePubAppModal) closePubAppModal.addEventListener('click', () => pubAppModal.classList.add('hidden'));
  if (cancelPubAppBtn) cancelPubAppBtn.addEventListener('click', () => pubAppModal.classList.add('hidden'));

  document.getElementById('publish-app-form').addEventListener('submit', async (e) => {
    e.preventDefault();
    const btn = document.getElementById('confirm-publish-app-btn');
    btn.disabled = true;
    btn.innerText = 'Publishing...';
    try {
      const res = await fetch(`/api/guilds/${guildId}/applications/publish-panel`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          formId: pubAppFormId.value,
          channelId: document.getElementById('publish-app-channel').value
        })
      });
      const data = await res.json();
      if (data.success) {
        alert('Application panel published to Discord!');
        window.location.reload();
      } else {
        alert(data.error || 'Failed to publish');
        btn.disabled = false;
        btn.innerText = 'Publish Now';
      }
    } catch {
      alert('Network error');
      btn.disabled = false;
      btn.innerText = 'Publish Now';
    }
  });

  // View Answers Modal
  const answersModal = document.getElementById('answers-modal');
  const answersContent = document.getElementById('answers-content');
  const closeAnswersModal = document.getElementById('close-answers-modal');
  const dismissAnswersBtn = document.getElementById('dismiss-answers-btn');

  document.querySelectorAll('.view-answers-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      const sub = JSON.parse(btn.getAttribute('data-sub'));
      document.getElementById('answers-modal-title').textContent = `Answers: ${sub.applicantTag} (${sub.submissionId})`;
      const answers = sub.answersJson || [];
      if (answers.length === 0) {
        answersContent.innerHTML = '<p class="text-slate-400">No responses recorded.</p>';
      } else {
        answersContent.innerHTML = answers.map((a, i) => `
          <div class="p-3 rounded-xl bg-[#0B0E14] border border-[#1E2538] space-y-1">
            <div class="text-xs font-bold text-blurple">Q${i + 1}: ${a.prompt}</div>
            <div class="text-xs text-slate-200 whitespace-pre-wrap">${a.answer || '*(Blank)*'}</div>
          </div>
        `).join('');
      }
      answersModal.classList.remove('hidden');
    });
  });

  if (closeAnswersModal) closeAnswersModal.addEventListener('click', () => answersModal.classList.add('hidden'));
  if (dismissAnswersBtn) dismissAnswersBtn.addEventListener('click', () => answersModal.classList.add('hidden'));

  // Accept / Deny Decision Modal
  let activeSubId = null;
  let activeDecision = null;
  const decisionModal = document.getElementById('decision-modal');
  const decisionTitle = document.getElementById('decision-title');
  const decisionNote = document.getElementById('decision-note');
  const confirmDecisionBtn = document.getElementById('confirm-decision-btn');
  const cancelDecisionBtn = document.getElementById('cancel-decision-btn');

  document.querySelectorAll('.decision-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      activeSubId = btn.getAttribute('data-id');
      activeDecision = btn.getAttribute('data-action');
      decisionNote.value = '';

      if (activeDecision === 'accepted') {
        decisionTitle.textContent = 'Accept Application';
        confirmDecisionBtn.textContent = 'Confirm Acceptance';
        confirmDecisionBtn.className = 'px-5 py-2.5 rounded-xl text-white text-xs font-bold bg-emerald-500 hover:bg-emerald-600 shadow-md shadow-emerald-500/20';
      } else {
        decisionTitle.textContent = 'Deny Application';
        confirmDecisionBtn.textContent = 'Confirm Rejection';
        confirmDecisionBtn.className = 'px-5 py-2.5 rounded-xl text-white text-xs font-bold bg-red-500 hover:bg-red-600 shadow-md shadow-red-500/20';
      }

      decisionModal.classList.remove('hidden');
    });
  });

  if (cancelDecisionBtn) cancelDecisionBtn.addEventListener('click', () => decisionModal.classList.add('hidden'));

  if (confirmDecisionBtn) {
    confirmDecisionBtn.addEventListener('click', async () => {
      confirmDecisionBtn.disabled = true;
      confirmDecisionBtn.innerText = 'Processing...';

      try {
        const res = await fetch(`/api/guilds/${guildId}/applications/submissions/${activeSubId}/status`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            status: activeDecision,
            note: decisionNote.value
          })
        });
        const data = await res.json();
        if (data.success) {
          window.location.reload();
        } else {
          alert(data.error || 'Failed to update status');
          confirmDecisionBtn.disabled = false;
        }
      } catch {
        alert('Network error');
        confirmDecisionBtn.disabled = false;
      }
    });
  }

  // Status Filter in table
  document.querySelectorAll('.status-filter-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      document.querySelectorAll('.status-filter-btn').forEach(b => {
        b.className = 'status-filter-btn px-3 py-1 rounded-lg font-bold text-slate-400 hover:text-white';
      });
      btn.className = 'status-filter-btn px-3 py-1 rounded-lg font-bold bg-blurple text-white';

      const status = btn.getAttribute('data-status');
      document.querySelectorAll('.sub-row').forEach(row => {
        if (status === 'all' || row.getAttribute('data-status') === status) {
          row.style.display = '';
        } else {
          row.style.display = 'none';
        }
      });
    });
  });

  if (window.lucide) window.lucide.createIcons();
});
</script>

<%- include('partials/footer') %>
