<%- include('partials/head', { title: `${guild.name} • Support Tickets` }) %>
<%- include('partials/navbar') %>

<div class="flex-1 flex">
  <%- include('partials/sidebar', { tab: 'tickets', guild }) %>

  <main class="flex-1 p-6 sm:p-10 space-y-8 overflow-y-auto max-w-6xl">
    <div class="border-b border-[#1E2538] pb-6">
      <h1 class="text-2xl sm:text-3xl font-black text-white tracking-tight">Support Tickets & HTML Transcripts</h1>
      <p class="text-slate-400 text-sm mt-1">BotGhost-style multi-category ticket channels, claim workflows, and archived HTML transcripts.</p>
    </div>

    <% const tickets = settings.tickets || {}; %>
    <!-- Ticket Configuration Form -->
    <form action="/api/guilds/<%= guild.id %>/tickets" method="POST" class="ajax-save-form space-y-6">
      <div class="glass-card p-6 space-y-6">
        <h2 class="text-lg font-bold text-white flex items-center gap-2">
          <i data-lucide="settings" class="w-5 h-5 text-blurple"></i>
          <span>Ticket System Roles & Channels</span>
        </h2>

        <div class="grid grid-cols-1 sm:grid-cols-3 gap-6">
          <div>
            <label class="block text-xs font-semibold text-slate-400 uppercase tracking-wider mb-2">Support Staff Role</label>
            <select name="supportRoleId" class="w-full bg-[#0B0E14] border border-[#1E2538] rounded-xl px-4 py-2.5 text-white focus:outline-none focus:border-blurple text-sm">
              <option value="">No role (Admins only)</option>
              <% roles.forEach(r => { %>
                <option value="<%= r.id %>" <%= tickets.supportRoleId === r.id ? 'selected' : '' %>>@<%= r.name %></option>
              <% }); %>
            </select>
          </div>

          <div>
            <label class="block text-xs font-semibold text-slate-400 uppercase tracking-wider mb-2">Ticket Category (Discord)</label>
            <select name="categoryId" class="w-full bg-[#0B0E14] border border-[#1E2538] rounded-xl px-4 py-2.5 text-white focus:outline-none focus:border-blurple text-sm">
              <option value="">No category (Root)</option>
              <% categories.forEach(cat => { %>
                <option value="<%= cat.id %>" <%= tickets.categoryId === cat.id ? 'selected' : '' %>><%= cat.name %></option>
              <% }); %>
            </select>
          </div>

          <div>
            <label class="block text-xs font-semibold text-slate-400 uppercase tracking-wider mb-2">Transcript Log Channel</label>
            <select name="logChannelId" class="w-full bg-[#0B0E14] border border-[#1E2538] rounded-xl px-4 py-2.5 text-white focus:outline-none focus:border-blurple text-sm">
              <option value="">No channel</option>
              <% channels.forEach(ch => { %>
                <option value="<%= ch.id %>" <%= tickets.logChannelId === ch.id ? 'selected' : '' %>># <%= ch.name %></option>
              <% }); %>
            </select>
          </div>
        </div>

        <button type="submit" class="bg-blurple hover:bg-blurple-hover text-white text-sm font-bold px-6 py-2.5 rounded-xl transition flex items-center gap-2 shadow-lg shadow-blurple/25">
          <i data-lucide="save" class="w-4 h-4"></i>
          <span>Save Ticket Settings</span>
        </button>
      </div>
    </form>

    <!-- Saved Tickets & Transcripts Table -->
    <div class="glass-card p-6 space-y-4">
      <div class="flex items-center justify-between border-b border-[#1E2538] pb-4">
        <div>
          <h2 class="text-lg font-bold text-white">Saved Tickets & HTML Transcripts</h2>
          <p class="text-xs text-slate-400">All created and closed support tickets with direct browser transcript viewing.</p>
        </div>
        <span class="text-xs text-slate-500"><%= ticketList.length %> Tickets</span>
      </div>

      <% if (ticketList.length === 0) { %>
        <div class="text-center py-10 text-slate-500 text-sm">
          No support tickets created yet on this server.
        </div>
      <% } else { %>
        <div class="overflow-x-auto">
          <table class="w-full text-left text-sm">
            <thead>
              <tr class="text-xs text-slate-400 border-b border-[#1E2538]">
                <th class="py-3 px-4">Ticket ID</th>
                <th class="py-3 px-4">User</th>
                <th class="py-3 px-4">Category</th>
                <th class="py-3 px-4">Status</th>
                <th class="py-3 px-4">Created</th>
                <th class="py-3 px-4 text-right">Transcript</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-[#1E2538]">
              <% ticketList.forEach(t => { %>
                <tr class="hover:bg-[#181F2E]/50 transition">
                  <td class="py-3 px-4 font-mono text-xs text-blurple"><%= t.id %></td>
                  <td class="py-3 px-4 text-slate-300 font-medium"><%= t.userName || t.userId %></td>
                  <td class="py-3 px-4 text-slate-400 uppercase text-xs font-semibold"><%= t.category || 'General' %></td>
                  <td class="py-3 px-4">
                    <% if (t.status === 'open') { %>
                      <span class="text-xs font-semibold px-2 py-0.5 rounded-full bg-emerald-500/10 text-emerald-400 border border-emerald-500/20">
                        🟢 Open
                      </span>
                    <% } else { %>
                      <span class="text-xs font-semibold px-2 py-0.5 rounded-full bg-slate-700/50 text-slate-400 border border-slate-600/30">
                        🔒 Closed
                      </span>
                    <% } %>
                  </td>
                  <td class="py-3 px-4 text-slate-500 text-xs">
                    <%= new Date(t.createdAt).toLocaleDateString() %>
                  </td>
                  <td class="py-3 px-4 text-right">
                    <% if (t.transcriptHtml) { %>
                      <a href="/transcript/<%= t.id %>" target="_blank" class="inline-flex items-center gap-1.5 text-xs font-semibold text-blurple hover:text-white bg-blurple/10 hover:bg-blurple px-3 py-1.5 rounded-lg border border-blurple/30 transition">
                        <i data-lucide="file-text" class="w-3.5 h-3.5"></i>
                        <span>View HTML Transcript</span>
                      </a>
                    <% } else { %>
                      <span class="text-xs text-slate-600">Pending Close</span>
                    <% } %>
                  </td>
                </tr>
              <% }); %>
            </tbody>
          </table>
        </div>
      <% } %>
    </div>
  </main>
</div>

<%- include('partials/footer') %>
