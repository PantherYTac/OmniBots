<!DOCTYPE html>
<html lang="en" class="dark">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Admin Login • OmniBots Discord Dashboard</title>
  
  <!-- Tailwind CSS via CDN -->
  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = {
      darkMode: 'class',
      theme: {
        extend: {
          colors: {
            blurple: {
              DEFAULT: '#5865F2',
              hover: '#4752C4'
            },
            dark: {
              900: '#0B0E14',
              800: '#131823',
              700: '#1E2538',
              600: '#2A344D'
            }
          }
        }
      }
    }
  </script>

  <!-- Lucide Icons CDN -->
  <script src="https://unpkg.com/lucide@latest"></script>
  <link rel="stylesheet" href="/css/custom.css">
</head>
<body class="bg-[#0B0E14] text-slate-200 min-h-screen flex flex-col items-center justify-center p-4 antialiased relative selection:bg-blurple selection:text-white">

  <!-- Blurple Ambient Glow Background -->
  <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[500px] h-[350px] bg-blurple/15 rounded-full blur-[130px] -z-10 pointer-events-none"></div>

  <main class="w-full max-w-md">
    <!-- Brand / Header -->
    <div class="text-center mb-8 space-y-3">
      <img src="/images/logo.svg" alt="OmniBots" class="h-14 w-auto mx-auto">
      <p class="text-xs text-slate-400 font-medium">Master Administrator Access Gate</p>
    </div>

    <!-- Login Glass Card -->
    <div class="glass-card p-8 space-y-6 border border-[#1E2538] shadow-2xl relative">
      <!-- Error Banner -->
      <% if (typeof error !== 'undefined' && error) { %>
        <div class="p-3.5 rounded-xl bg-red-500/10 border border-red-500/30 text-red-400 text-xs font-semibold flex items-center gap-2.5 animate-shake">
          <i data-lucide="alert-circle" class="w-4 h-4 flex-shrink-0"></i>
          <span><%= error %></span>
        </div>
      <% } %>

      <!-- Notice Banner -->
      <% if (typeof notice !== 'undefined' && notice) { %>
        <div class="p-3.5 rounded-xl bg-blurple/10 border border-blurple/30 text-blurple text-xs font-semibold flex items-center gap-2.5">
          <i data-lucide="info" class="w-4 h-4 flex-shrink-0"></i>
          <span><%= notice %></span>
        </div>
      <% } %>

      <form action="/login" method="POST" class="space-y-5">
        <div>
          <label class="block text-xs font-semibold text-slate-400 uppercase tracking-wider mb-2">Master Username</label>
          <div class="relative">
            <span class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-slate-500">
              <i data-lucide="user" class="w-4 h-4"></i>
            </span>
            <input 
              type="text" 
              name="username" 
              required 
              autofocus 
              autocomplete="username"
              placeholder="admin"
              class="w-full bg-[#0B0E14] border border-[#1E2538] rounded-xl pl-10 pr-4 py-2.5 text-white placeholder-slate-600 focus:outline-none focus:border-blurple text-sm transition"
            >
          </div>
        </div>

        <div>
          <label class="block text-xs font-semibold text-slate-400 uppercase tracking-wider mb-2">Master Password</label>
          <div class="relative">
            <span class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-slate-500">
              <i data-lucide="lock" class="w-4 h-4"></i>
            </span>
            <input 
              type="password" 
              id="admin_password" 
              name="password" 
              required 
              autocomplete="current-password"
              placeholder="••••••••••••"
              class="w-full bg-[#0B0E14] border border-[#1E2538] rounded-xl pl-10 pr-11 py-2.5 text-white placeholder-slate-600 focus:outline-none focus:border-blurple text-sm transition"
            >
            <button 
              type="button" 
              id="toggle_password_btn" 
              title="Show/Hide Password"
              class="absolute inset-y-0 right-0 pr-3.5 flex items-center text-slate-500 hover:text-slate-300 transition"
            >
              <i data-lucide="eye" id="eye_icon" class="w-4 h-4"></i>
            </button>
          </div>
        </div>

        <button 
          type="submit" 
          class="w-full bg-blurple hover:bg-blurple-hover text-white font-bold py-3 rounded-xl transition flex items-center justify-center gap-2 shadow-lg shadow-blurple/30 transform hover:-translate-y-0.5 active:translate-y-0"
        >
          <i data-lucide="log-in" class="w-4 h-4"></i>
          <span>Authenticate to Dashboard</span>
        </button>
      </form>
    </div>

    <!-- Security Meta Info & Public Legal Links -->
    <div class="mt-8 text-center text-xs text-slate-500 space-y-3">
      <div class="flex items-center justify-center gap-1.5 font-medium">
        <i data-lucide="shield-check" class="w-3.5 h-3.5 text-emerald-400"></i>
        <span>Constant-Time Bcrypt Verification (SALT_ROUNDS = 12)</span>
      </div>
      <div>Session fixation protection & IP brute-force rate limiter enabled.</div>
      
      <div class="flex items-center justify-center gap-4 pt-1">
        <a href="/privacy" class="text-xs text-slate-400 hover:text-blurple transition flex items-center gap-1.5">
          <i data-lucide="shield" class="w-3.5 h-3.5"></i>
          <span>Privacy Policy</span>
        </a>
        <span class="text-slate-600">•</span>
        <a href="/terms" class="text-xs text-slate-400 hover:text-blurple transition flex items-center gap-1.5">
          <i data-lucide="file-text" class="w-3.5 h-3.5"></i>
          <span>Terms of Service</span>
        </a>
      </div>
    </div>
  </main>

  <script>
    document.addEventListener('DOMContentLoaded', () => {
      if (window.lucide) window.lucide.createIcons();

      const pwdInput = document.getElementById('admin_password');
      const toggleBtn = document.getElementById('toggle_password_btn');

      if (toggleBtn && pwdInput) {
        toggleBtn.addEventListener('click', () => {
          const isPass = pwdInput.type === 'password';
          pwdInput.type = isPass ? 'text' : 'password';
          toggleBtn.innerHTML = isPass ? '<i data-lucide="eye-off" class="w-4 h-4"></i>' : '<i data-lucide="eye" class="w-4 h-4"></i>';
          if (window.lucide) window.lucide.createIcons();
        });
      }
    });
  </script>
</body>
</html>
