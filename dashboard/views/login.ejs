<!DOCTYPE html>
<html lang="en" class="dark">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Admin Login • OmniBots Discord Dashboard</title>

  <!-- Tailwind CSS via CDN -->
  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = {
      darkMode: 'class',
      theme: {
        extend: {
          colors: {
            blurple: {
              DEFAULT: '#5865F2',
              hover: '#4752C4'
            },
            dark: {
              900: '#0B0E14',
              800: '#131823',
              700: '#1E2538',
              600: '#2A344D'
            }
          },
          fontFamily: {
            sans: ['Inter', 'system-ui', '-apple-system', 'sans-serif']
          }
        }
      }
    }
  </script>

  <!-- Inter Font -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">

  <!-- Lucide Icons CDN -->
  <script src="https://unpkg.com/lucide@latest"></script>
  <link rel="stylesheet" href="/css/custom.css">
</head>
<body class="bg-[#0B0E14] text-slate-200 min-h-screen flex flex-col items-center justify-center p-4 antialiased relative selection:bg-blurple selection:text-white overflow-hidden">

  <!-- Dot Grid Overlay -->
  <div class="absolute inset-0 -z-10 pointer-events-none" style="background-image: radial-gradient(circle, #1E2538 1px, transparent 1px); background-size: 32px 32px;"></div>

  <!-- Blurple Ambient Glow — center -->
  <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[500px] h-[350px] bg-blurple/15 rounded-full blur-[130px] -z-10 pointer-events-none"></div>

  <!-- Cyan blob — top-right -->
  <div class="absolute top-0 right-0 w-72 h-72 bg-cyan-500/5 rounded-full blur-[100px] -z-10 pointer-events-none"></div>

  <!-- Indigo blob — bottom-left -->
  <div class="absolute bottom-0 left-0 w-72 h-72 bg-indigo-600/8 rounded-full blur-[100px] -z-10 pointer-events-none"></div>

  <main class="w-full max-w-md">
    <!-- Brand / Header -->
    <div class="text-center mb-8 space-y-3">
      <img src="/images/logo.svg" alt="OmniBots" class="h-10 w-auto mx-auto">
      <div>
        <span class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full text-[11px] font-semibold bg-blurple/10 border border-blurple/30 text-blurple">
          <i data-lucide="shield" class="w-3 h-3"></i>
          Admin Console
        </span>
      </div>
    </div>

    <!-- Login Card -->
    <div class="relative bg-[#0D1117] border border-white/[0.08] rounded-2xl p-8 shadow-2xl overflow-hidden">
      <!-- Top highlight line -->
      <div class="absolute inset-x-0 top-0 h-px bg-gradient-to-r from-transparent via-blurple/30 to-transparent pointer-events-none"></div>

      <div class="space-y-6">
        <!-- Error Banner -->
        <% if (typeof error !== 'undefined' && error) { %>
          <div class="p-3.5 rounded-xl bg-red-500/10 border border-red-500/30 text-red-400 text-xs font-semibold flex items-center gap-2.5 animate-shake">
            <i data-lucide="alert-circle" class="w-4 h-4 flex-shrink-0"></i>
            <span><%= error %></span>
          </div>
        <% } %>

        <!-- Notice Banner -->
        <% if (typeof notice !== 'undefined' && notice) { %>
          <div class="p-3.5 rounded-xl bg-blurple/10 border border-blurple/30 text-blurple text-xs font-semibold flex items-center gap-2.5">
            <i data-lucide="info" class="w-4 h-4 flex-shrink-0"></i>
            <span><%= notice %></span>
          </div>
        <% } %>

        <form action="/login" method="POST" class="space-y-5">
          <!-- Username Field -->
          <div>
            <label class="block text-[11px] font-semibold uppercase tracking-wider text-slate-500 mb-1.5">Master Username</label>
            <div class="relative">
              <span class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-slate-600">
                <i data-lucide="user" class="w-4 h-4"></i>
              </span>
              <input
                type="text"
                name="username"
                required
                autofocus
                autocomplete="username"
                placeholder="admin"
                class="w-full bg-[#0B0E14] border border-white/[0.08] rounded-xl py-3 pl-10 pr-4 text-white placeholder-slate-600 focus:outline-none focus:border-blurple/60 text-sm transition duration-150"
              >
            </div>
          </div>

          <!-- Password Field -->
          <div>
            <label class="block text-[11px] font-semibold uppercase tracking-wider text-slate-500 mb-1.5">Master Password</label>
            <div class="relative">
              <span class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-slate-600">
                <i data-lucide="lock" class="w-4 h-4"></i>
              </span>
              <input
                type="password"
                id="admin_password"
                name="password"
                required
                autocomplete="current-password"
                placeholder="••••••••••••"
                class="w-full bg-[#0B0E14] border border-white/[0.08] rounded-xl py-3 pl-10 pr-11 text-white placeholder-slate-600 focus:outline-none focus:border-blurple/60 text-sm transition duration-150"
              >
              <button
                type="button"
                id="toggle_password_btn"
                title="Show/Hide Password"
                class="absolute inset-y-0 right-0 pr-3.5 flex items-center text-slate-500 hover:text-slate-300 transition"
              >
                <i data-lucide="eye" id="eye_icon" class="w-4 h-4"></i>
              </button>
            </div>
          </div>

          <!-- Submit Button -->
          <button
            type="submit"
            class="w-full bg-gradient-to-r from-blurple to-indigo-500 hover:from-indigo-500 hover:to-blurple text-white font-bold py-3 rounded-xl transition-all duration-200 flex items-center justify-center gap-2 shadow-lg shadow-blurple/25 hover:-translate-y-0.5 active:translate-y-0"
          >
            <i data-lucide="log-in" class="w-4 h-4"></i>
            <span>Authenticate to Dashboard</span>
          </button>
        </form>
      </div>
    </div>

    <!-- Security & Legal Footer -->
    <div class="mt-6 text-center space-y-3">
      <div class="flex items-center justify-center gap-1.5 text-[11px] text-slate-500 font-medium">
        <i data-lucide="lock" class="w-3.5 h-3.5 text-emerald-500/70"></i>
        <span>Secured with bcrypt + AES-256-GCM</span>
      </div>
      <div class="flex items-center justify-center gap-4">
        <a href="/privacy" class="text-[11px] text-slate-500 hover:text-blurple transition">Privacy Policy</a>
        <span class="text-slate-700">•</span>
        <a href="/terms" class="text-[11px] text-slate-500 hover:text-blurple transition">Terms of Service</a>
      </div>
    </div>
  </main>

  <script>
    document.addEventListener('DOMContentLoaded', () => {
      if (window.lucide) window.lucide.createIcons();

      const pwdInput = document.getElementById('admin_password');
      const toggleBtn = document.getElementById('toggle_password_btn');

      if (toggleBtn && pwdInput) {
        toggleBtn.addEventListener('click', () => {
          const isPass = pwdInput.type === 'password';
          pwdInput.type = isPass ? 'text' : 'password';
          toggleBtn.innerHTML = isPass ? '<i data-lucide="eye-off" class="w-4 h-4"></i>' : '<i data-lucide="eye" class="w-4 h-4"></i>';
          if (window.lucide) window.lucide.createIcons();
        });
      }
    });
  </script>
</body>
</html>
