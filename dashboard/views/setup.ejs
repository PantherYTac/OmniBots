<!DOCTYPE html>
<html lang="en" class="dark">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Setup Wizard • OmniBots</title>
  
  <link rel="icon" type="image/svg+xml" href="/favicon.svg">
  <link rel="alternate icon" href="/favicon.ico">

  <!-- Tailwind CSS via CDN -->
  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = {
      darkMode: 'class',
      theme: {
        extend: {
          colors: {
            blurple: {
              DEFAULT: '#5865F2',
              hover: '#4752C4'
            },
            cyan: {
              accent: '#38BDF8'
            },
            dark: {
              900: '#0B0E14',
              800: '#131823',
              700: '#1E2538',
              600: '#2A344D'
            }
          }
        }
      }
    }
  </script>

  <!-- Lucide Icons CDN -->
  <script src="https://unpkg.com/lucide@latest"></script>
  <link rel="stylesheet" href="/css/custom.css">
</head>
<body class="bg-[#0B0E14] text-slate-200 min-h-screen flex flex-col items-center justify-center p-4 antialiased relative selection:bg-blurple selection:text-white">

  <!-- Glow Ambient Background -->
  <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[550px] h-[380px] bg-gradient-to-tr from-blurple/20 to-cyan-accent/15 rounded-full blur-[140px] -z-10 pointer-events-none"></div>

  <main class="w-full max-w-lg">
    <!-- Brand / Header -->
    <div class="text-center mb-8 space-y-3">
      <img src="/images/logo.svg" alt="OmniBots" class="h-14 w-auto mx-auto">
      <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-semibold bg-cyan-accent/10 text-cyan-accent border border-cyan-accent/30">
        <i data-lucide="sparkles" class="w-3.5 h-3.5"></i>
        <span>Zero-Env First-Run Wizard</span>
      </div>
      <h1 class="text-xl font-bold text-white tracking-tight">Create Master Administrator Account</h1>
      <p class="text-xs text-slate-400">Initialize your self-hosted OmniBots panel with secure master credentials.</p>
    </div>

    <!-- Setup Card -->
    <div class="glass-card p-8 space-y-6 border border-[#1E2538] shadow-2xl relative">
      <!-- Error Banner -->
      <% if (typeof error !== 'undefined' && error) { %>
        <div class="p-3.5 rounded-xl bg-red-500/10 border border-red-500/30 text-red-400 text-xs font-semibold flex items-center gap-2.5 animate-shake">
          <i data-lucide="alert-circle" class="w-4 h-4 flex-shrink-0"></i>
          <span><%= error %></span>
        </div>
      <% } %>

      <form action="/setup" method="POST" class="space-y-5">
        <div>
          <label class="block text-xs font-semibold text-slate-400 uppercase tracking-wider mb-2">Master Admin Username</label>
          <div class="relative">
            <span class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-slate-500">
              <i data-lucide="user" class="w-4 h-4"></i>
            </span>
            <input 
              type="text" 
              name="username" 
              required 
              autofocus 
              placeholder="e.g. admin"
              class="w-full bg-[#0B0E14] border border-[#1E2538] rounded-xl pl-10 pr-4 py-2.5 text-white placeholder-slate-600 focus:outline-none focus:border-blurple text-sm transition"
            >
          </div>
        </div>

        <div>
          <label class="block text-xs font-semibold text-slate-400 uppercase tracking-wider mb-2">Master Password</label>
          <div class="relative">
            <span class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-slate-500">
              <i data-lucide="lock" class="w-4 h-4"></i>
            </span>
            <input 
              type="password" 
              id="setup_password" 
              name="password" 
              required 
              minlength="8"
              placeholder="Minimum 8 characters"
              class="w-full bg-[#0B0E14] border border-[#1E2538] rounded-xl pl-10 pr-11 py-2.5 text-white placeholder-slate-600 focus:outline-none focus:border-blurple text-sm transition"
            >
            <button 
              type="button" 
              id="toggle_password_btn" 
              class="absolute inset-y-0 right-0 pr-3.5 flex items-center text-slate-500 hover:text-slate-300 transition"
            >
              <i data-lucide="eye" id="eye_icon" class="w-4 h-4"></i>
            </button>
          </div>
        </div>

        <div>
          <label class="block text-xs font-semibold text-slate-400 uppercase tracking-wider mb-2">Confirm Password</label>
          <div class="relative">
            <span class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-slate-500">
              <i data-lucide="check-circle" class="w-4 h-4"></i>
            </span>
            <input 
              type="password" 
              name="confirmPassword" 
              required 
              minlength="8"
              placeholder="Re-enter your password"
              class="w-full bg-[#0B0E14] border border-[#1E2538] rounded-xl pl-10 pr-4 py-2.5 text-white placeholder-slate-600 focus:outline-none focus:border-blurple text-sm transition"
            >
          </div>
        </div>

        <!-- Automatic Security Highlights -->
        <div class="p-3.5 rounded-xl bg-[#0B0E14] border border-[#1E2538] space-y-1.5 text-xs text-slate-400">
          <div class="font-bold text-white flex items-center gap-1.5">
            <i data-lucide="shield-check" class="w-4 h-4 text-emerald-400"></i>
            <span>Built-in Zero-Config Security</span>
          </div>
          <div>• Password will be hashed using <strong>bcryptjs (12 salt rounds)</strong>.</div>
          <div>• AES-256-GCM encryption keys generated automatically in <code>/data/config.json</code>.</div>
          <div>• Setup gate will permanently lock upon submission.</div>
        </div>

        <button 
          type="submit" 
          class="w-full bg-gradient-to-r from-blurple to-indigo-600 hover:from-blurple-hover hover:to-indigo-500 text-white font-bold py-3 rounded-xl transition flex items-center justify-center gap-2 shadow-lg shadow-blurple/30 transform hover:-translate-y-0.5 active:translate-y-0"
        >
          <i data-lucide="check" class="w-4 h-4"></i>
          <span>Complete Setup & Launch Dashboard</span>
        </button>
      </form>
    </div>

    <!-- Public Legal Links -->
    <div class="mt-8 text-center text-xs text-slate-500 space-y-2">
      <div class="flex items-center justify-center gap-4">
        <a href="/privacy" class="text-xs text-slate-400 hover:text-blurple transition flex items-center gap-1">
          <i data-lucide="shield" class="w-3.5 h-3.5"></i> Privacy Policy
        </a>
        <span class="text-slate-600">•</span>
        <a href="/terms" class="text-xs text-slate-400 hover:text-blurple transition flex items-center gap-1">
          <i data-lucide="file-text" class="w-3.5 h-3.5"></i> Terms of Service
        </a>
      </div>
      <div>OmniBots Open-Source Platform • Self-Hosted Edition</div>
    </div>
  </main>

  <script>
    document.addEventListener('DOMContentLoaded', () => {
      if (window.lucide) window.lucide.createIcons();

      const pwdInput = document.getElementById('setup_password');
      const toggleBtn = document.getElementById('toggle_password_btn');

      if (toggleBtn && pwdInput) {
        toggleBtn.addEventListener('click', () => {
          const isPass = pwdInput.type === 'password';
          pwdInput.type = isPass ? 'text' : 'password';
          toggleBtn.innerHTML = isPass ? '<i data-lucide="eye-off" class="w-4 h-4"></i>' : '<i data-lucide="eye" class="w-4 h-4"></i>';
          if (window.lucide) window.lucide.createIcons();
        });
      }
    });
  </script>
</body>
</html>
