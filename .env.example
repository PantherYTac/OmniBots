# ==============================================================================
# OmniBots - Optional Environment Variables
# ==============================================================================
# ZERO ENVIRONMENT VARIABLES ARE REQUIRED ON HOSTINGER!
# OmniBots automatically creates /data/config.json and initializes a secure
# persistent database on first boot. On first launch, open http://yourdomain/
# to complete the 30-second setup wizard.
#
# If you wish to manually override settings via Hostinger or VPS environment,
# uncomment and set any of the optional variables below:
# ==============================================================================

# Port (Hostinger sets this automatically)
# PORT=3000

# Public Dashboard URL (Optional: defaults to Hostinger domain automatically)
# DASHBOARD_URL=https://yourdomain.com

# External Database (Optional: defaults to built-in high-performance local store)
# DATABASE_URL=mongodb+srv://... or postgresql://...

# Optional AI Chat Integration (Google Gemini API)
# GEMINI_API_KEY=your_gemini_api_key_here
