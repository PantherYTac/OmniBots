# ==========================================
# Discord Bot & Dashboard Environment Config
# ==========================================

# ------------------------------------------
# 1. Master Web Dashboard Admin Credentials
# ------------------------------------------
# Primary Master Admin Username
ADMIN_USERNAME=admin

# Pre-computed bcrypt hash (SALT_ROUNDS = 12)
# Generate with: npm run generate-hash
ADMIN_PASSWORD_HASH=

# Optional fallback plaintext password (auto-hashed at boot if ADMIN_PASSWORD_HASH is empty)
# NEVER use plaintext in production on Hostinger; always use ADMIN_PASSWORD_HASH instead!
ADMIN_PASSWORD=change_this_master_password_immediately

# Public Leaderboard toggle: false = locked behind admin login, true = publicly shareable
PUBLIC_LEADERBOARD=false

# ------------------------------------------
# 2. Discord Bot Credentials & OAuth2
# ------------------------------------------
# From https://discord.com/developers/applications
DISCORD_TOKEN=your_bot_token_here
CLIENT_ID=your_discord_client_id_here
CLIENT_SECRET=your_discord_client_secret_here

# Discord OAuth2 Redirect Callback URL
# Local development: http://localhost:3000/auth/discord/callback
# Production (Hostinger): https://yourdomain.com/auth/discord/callback
CALLBACK_URL=http://localhost:3000/auth/discord/callback

# Public Dashboard Root URL (Used for generating /privacy, /terms, and button links)
# Local development: http://localhost:3000
# Production (Hostinger): https://yourdomain.com
DASHBOARD_URL=http://localhost:3000

# ------------------------------------------
# 3. Security & Database Configuration
# ------------------------------------------
# Web Dashboard Session Secret (Generate a strong random string)
SESSION_SECRET=super_secret_session_key_change_in_production_12345!

# Shared Database Connection String
# 1. MongoDB: mongodb+srv://username:password@cluster.mongodb.net/discord_bot?retryWrites=true&w=majority
# 2. PostgreSQL / Supabase: postgresql://postgres:password@db.supabase.co:5432/postgres
# 3. Leave empty or set to "local" to use the built-in fast JSON/SQLite fallback store (zero config!)
DATABASE_URL=

# ------------------------------------------
# 4. Optional AI Integration & Hostinger Settings
# ------------------------------------------
# AI Chat Integration (@google/genai Gemini API)
# Get your API key at https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Server Port (Hostinger automatically injects PORT or defaults to 3000)
PORT=3000
NODE_ENV=production

# Mode for index.js runner:
# "all" = runs both Bot and Dashboard in one single process (Recommended for single-container Hostinger plans)
# "dashboard" = runs dashboard only
# "bot" = runs bot only
APP_MODE=all
