    "reaction-roles",
    "leveling",
    "economy"
  ],
  "author": "Antigravity Engineering",
  "license": "MIT",
  "dependencies": {
    "@discordjs/rest": "^2.4.0",
    "@google/genai": "^3.2.0",
    "@napi-rs/canvas": "^0.1.66",
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "discord-api-types": "^0.37.104",
    "discord.js": "^14.16.3",
    "dotenv": "^16.4.7",
    "ejs": "^3.1.10",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "express-session": "^1.18.1",
    "mongoose": "^8.9.0",
    "pg": "^8.13.1"
