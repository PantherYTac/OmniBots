{
  "name": "discord-bot-dashboard",
  "version": "1.0.0",
  "description": "Production-ready, all-in-one Discord.js v14 Bot with a modern Express.js + Tailwind CSS Web Dashboard for Hostinger Node.js hosting",
  "main": "index.js",
  "scripts": {
    "start": "node index.js",
    "start:dashboard": "node dashboard/server.js",
    "start:bot": "node bot/index.js",
    "start:all": "node index.js",
    "deploy:commands": "node bot/deploy-commands.js",
    "generate-hash": "node scripts/generate-hash.js",
    "dev": "nodemon index.js",
    "dev:dashboard": "nodemon dashboard/server.js",
    "dev:bot": "nodemon bot/index.js"
  },
  "keywords": [
    "discord-bot",
    "discordjs-v14",
    "web-dashboard",
    "hostinger-ready",
    "moderation",
